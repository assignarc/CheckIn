{% extends 'base.html.twig' %}

{% block title %}Expired Kiosk Link - TimeFlow{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-center p-8" style="min-height: 100vh">
    <div class="glass-panel text-center w-100 max-w-500">
        <div class="text-danger d-inline-flex align-items-center justify-content-center mb-6 rounded-full" style="width: 70px; height: 70px; background: var(--danger-glow)">
            <span class="material-icons fs-4xl">lock_reset</span>
        </div>
        <h2 class="mb-0 fs-2xl mb-2">Access Link Expired</h2>
        <h4 class="text-secondary mb-6">{{ org_name }}</h4>
        
        <div class="alert alert-danger text-left mb-8">
            <span class="material-icons">info</span>
            <span>{{ error }}</span>
        </div>

        <a href="{{ path('app_home') }}" class="btn btn-secondary w-100">
            <span class="material-icons">arrow_back</span> Back to Home
        </a>
    </div>
</div>
{% endblock %}
