{% extends 'base.html.twig' %}

{% block title %}Page Not Found - CenterTime{% endblock %}

{% block body %}
<div class="d-flex flex-column align-items-center justify-content-center text-center p-8" style="min-height: 100vh; background: var(--bg-main);">
    <div class="glass-panel p-10 max-w-500 d-flex flex-column align-items-center gap-6" style="box-shadow: var(--shadow-xl); border: 1px solid rgba(99, 102, 241, 0.2); margin: auto;">
        <div class="avatar bg-primary-glow rounded-full d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; color: var(--primary); background: var(--primary-glow);">
            <span class="material-icons" style="font-size: 3rem; display: flex; align-items: center; justify-content: center;">search_off</span>
        </div>
        
        <div>
            <h1 class="fs-3xl fw-800 text-white mb-2">Page Not Found</h1>
            <p class="fs-md text-secondary lh-relaxed">
                The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
            </p>
        </div>

        <div class="d-flex gap-4">
            <a href="{{ path('app_home') }}" class="btn btn-primary fs-sm" style="text-decoration: none;">
                Return Home
            </a>
            <button onclick="window.history.back()" class="btn btn-secondary fs-sm">
                Go Back
            </button>
        </div>
    </div>
</div>
{% endblock %}
