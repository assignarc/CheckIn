{% extends 'admin/layout.html.twig' %}

{% block title %}Scheduled Jobs{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">Scheduled Jobs</h2>
</div>

<div class="glass-panel m-0 max-w-800" >
    <h3 class="fs-xl d-flex align-items-center gap-2 mb-4">
        <span class="material-icons text-primary">schedule</span> Automated Cron Tasks
    </h3>
    
    <p class="fs-sm text-secondary mb-5">
        Because shared hosting providers (like SiteGround) do not allow persistent background daemons, 
        CenterTime's scheduled tasks have been consolidated into a single, secure web endpoint. 
    </p>

    <div class="mb-5 p-6 rounded-md border" style="background: rgba(255,255,255,0.03)">
        <h4 class="fs-md mt-0 mb-3 d-flex align-items-center gap-2">
            <span class="material-icons text-success fs-md">link</span> Your Secret Cron URL
        </h4>
        <div class="bg-input mb-4 p-3 rounded-md border">
            <code class="text-primary" style="word-break: break-all; font-size: 0.75rem">
                {{ url('app_cron_run', { 'token': cronToken }) }}
            </code>
        </div>
        
        <h5 class="fs-sm mt-0 mb-2">How to configure in SiteGround:</h5>
        <ol class="fs-sm text-secondary ps-4 mb-0" style="line-height: 1.6">
            <li>Log into your SiteGround <strong>Site Tools</strong>.</li>
            <li>Navigate to <strong>Devs > Cron Jobs</strong>.</li>
            <li>Set the interval to run <strong>Every 5 minutes</strong> (<code>*/5 * * * *</code>).</li>
            <li>In the Command box, paste exactly this:</li>
        </ol>
        <div class="bg-input mt-3 p-3 rounded-md border">
            <code class="text-primary" style="word-break: break-all; font-size: 0.75rem">
                wget -q -O /dev/null "{{ url('app_cron_run', { 'token': cronToken }) }}"
            </code>
        </div>
    </div>

    <h4 class="fs-md mb-3">Tasks Executed Automatically:</h4>
    <div class="d-flex flex-column gap-3">
        <div class="p-4 rounded-md border" style="background: rgba(255,255,255,0.02)">
            <div class="fw-bold fs-sm mb-1">1. Sweep Active Sessions</div>
            <div class="fs-xs text-muted">Automatically ends open work sessions that have exceeded the maximum hours allowed by their organization's plan. Runs every 5 minutes.</div>
        </div>
        <div class="p-4 rounded-md border" style="background: rgba(255,255,255,0.02)">
            <div class="fw-bold fs-sm mb-1">2. Rotate Demo Credentials</div>
            <div class="fs-xs text-muted">Automatically rotates passwords and kiosk tokens for public Demo organizations every {{ demoRotationHours|default(12) }} hours. The cron endpoint checks the elapsed time dynamically.</div>
        </div>
        <div class="p-4 rounded-md border" style="background: rgba(255,255,255,0.02)">
            <div class="fw-bold fs-sm mb-1">3. Archive Audit Logs</div>
            <div class="fs-xs text-muted">Automatically archives logs older than the configured global retention period to a JSON zipped file on the server.</div>
        </div>
        <div class="alert alert-info mt-4">
            <span class="material-icons text-info">info</span>
            <div class="ms-2">
                <strong>Wait, isn't there another way?</strong><br>
                Yes! If you have direct CLI access to the server, you can trigger these manually or set them up in standard server crontab:
                <ul class="mb-0 mt-2 text-primary fs-sm">
                    <li>Sweep Sessions: <code>php bin/console app:sweep-sessions</code></li>
                    <li>Archive Audit Logs: <code>php bin/console app:archive-audit-logs</code></li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
