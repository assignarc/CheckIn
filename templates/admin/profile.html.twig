{% extends 'admin/layout.html.twig' %}

{% block title %}Admin Profile - TimeFlow{% endblock %}

{% block admin_content %}
<div class="content-header mb-6">
    <h1 class="fs-2xl fw-700 mb-1">Admin Profile</h1>
    <p class="fs-md text-secondary m-0">Manage your system administrator account settings.</p>
</div>

<div class="card max-w-600">
    <div class="card-body">
        <form method="post">
            <div class="d-flex gap-4 mb-4">
                <div class="form-group flex-1">
                    <label class="form-label">First Name</label>
                    <input type="text" name="firstName" value="{{ user.firstName }}" class="form-control" required>
                </div>
                <div class="form-group flex-1">
                    <label class="form-label">Last Name</label>
                    <input type="text" name="lastName" value="{{ user.lastName }}" class="form-control" required>
                </div>
            </div>

            <div class="form-group mb-6">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" value="{{ user.email }}" class="form-control" required>
            </div>

            <hr style="border-color:var(--border-color); margin:1.5rem 0;">
            <h3 class="fs-md mb-4">Change Password</h3>

            <div class="form-group mb-6">
                <label class="form-label">New Password (leave blank to keep current)</label>
                <input type="password" name="password" class="form-control" placeholder="Enter new password...">
            </div>

            <div class="text-right">
                <button type="submit" class="btn btn-primary">Save Profile</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
