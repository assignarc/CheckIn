{% extends 'admin/layout.html.twig' %}

{% block title %}Demo Leads - Platform Admin{% endblock %}
{% block header_title %}Demo Requests{% endblock %}

{% block admin_content %}
<div class="glass-panel">
    <div class="d-flex align-items-center justify-content-between mb-6">
        <h3 class="m-0">Recent Demo Requests (Leads)</h3>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for lead in leads %}
                    <tr>
                        <td>{{ lead.createdAt|date('Y-m-d H:i') }}</td>
                        <td class="fw-600">{{ lead.name }}</td>
                        <td>{{ lead.email }}</td>
                        <td>{{ lead.phone|default('—') }}</td>
                        <td>{{ lead.company|default('—') }}</td>
                        <td class="text-right">
                            <form action="{{ path('app_admin_demo_lead_delete', {id: lead.id}) }}" method="post" class="confirm-form m-0 d-inline-block" data-confirm="Are you sure you want to delete the demo lead for {{ lead.name }}?">
                                <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                    <span class="material-icons fs-md">delete</span> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted" style="padding: 2.5rem 0">
                            <span class="material-icons mb-0" style="font-size: 2.5rem; .5rem">group_add</span>
                            <p>No demo leads found.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Contact Us Inquiries Table -->
    <div class="d-flex align-items-center justify-content-between mb-6 mt-12">
        <h3 class="m-0 d-flex align-items-center gap-2">
            <span class="material-icons text-primary">mail</span>
            <span>Contact Us Inquiries</span>
        </h3>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for msg in contact_messages|default([]) %}
                    <tr>
                        <td>{{ msg.createdAt|date('Y-m-d H:i') }}</td>
                        <td class="fw-600">{{ msg.name }}</td>
                        <td><a href="mailto:{{ msg.email }}" class="text-primary">{{ msg.email }}</a></td>
                        <td>{{ msg.subject|default('—') }}</td>
                        <td style="max-width: 320px; white-space: normal;">{{ msg.message }}</td>
                        <td class="text-right">
                            <form action="{{ path('app_admin_contact_message_delete', {id: msg.id}) }}" method="post" class="confirm-form m-0 d-inline-block" data-confirm="Are you sure you want to delete this contact message from {{ msg.name }}?">
                                <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                    <span class="material-icons fs-md">delete</span> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted" style="padding: 2.5rem 0">
                            <span class="material-icons mb-0" style="font-size: 2.5rem;">mark_email_read</span>
                            <p>No contact messages received yet.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
