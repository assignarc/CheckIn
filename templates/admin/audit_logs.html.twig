{% extends 'admin/layout.html.twig' %}

{% block title %}System Audit Logs - Platform Admin{% endblock %}
{% block header_title %}Audit Logs{% endblock %}

{% block admin_content %}
<div class="glass-panel mb-8 p-6">
    <h3 class="fs-lg text-purple-300 mb-5">System-wide Audit Trail</h3>

    <form method="get" action="{{ path('app_admin_audit_logs') }}" class="d-flex gap-4 mb-6" style="align-items:flex-end">
        <div class="form-group flex-1 m-0">
            <label class="form-label" for="org_filter">Organization</label>
            <select name="org" id="org_filter" class="form-control">
                <option value="">All Organizations</option>
                {% for o in organizations %}
                    <option value="{{ o.id }}" {% if app.request.query.get('org') == o.id %}selected{% endif %}>{{ o.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="form-group flex-1 m-0">
            <label class="form-label" for="action_filter">Action</label>
            <input type="text" name="action" id="action_filter" class="form-control" value="{{ app.request.query.get('action') }}" placeholder="e.g. USER_CREATE">
        </div>
        <button type="submit" class="btn btn-secondary">
            <span class="material-icons">filter_list</span> Filter
        </button>
        <button type="button" onclick="window.location.reload();" class="btn btn-outline-secondary" title="Refresh Page">
            <span class="material-icons">refresh</span> Refresh
        </button>
        <a href="{{ path('app_admin_audit_logs', app.request.query.all|merge({'export': 'csv'})) }}" class="btn btn-primary">
            <span class="material-icons">download</span> Export CSV
        </a>
    </form>

    <div class="table-responsive">
        <table class="table fs-md">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Org</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr>
                        <td class="white-space-nowrap">{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td class="fw-600">{{ log.organization ? log.organization.name : 'System' }}</td>
                        <td>
                            {% if log.manager %}
                                {{ log.manager.email }}
                            {% else %}
                                System
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge-secondary">{{ log.action }}</span>
                        </td>
                        <td>
                            {% if log.detailsJson is iterable and log.detailsJson|length > 0 %}
                                <details class="fs-xs">
                                    <summary class="cursor-pointer text-purple-400 fw-600" style="outline: none; list-style: none;">
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <span class="material-icons fs-sm" style="font-size: 0.9rem;">unfold_more</span> Show Details
                                        </span>
                                    </summary>
                                    <div class="d-flex flex-column gap-1 mt-2 border-l pl-3" style="min-width: 220px; border-left: 2px solid var(--border-color);">
                                        {% for key, val in log.detailsJson %}
                                            <div>
                                                <span class="text-secondary fw-600">{{ key|replace({'_': ' '})|title }}:</span>
                                                <span class="text-primary">{{ val is iterable ? val|json_encode : val }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </details>
                            {% else %}
                                <span class="text-muted fs-xs">None</span>
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ log.ipAddress|default('—') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted p-8">
                            No audit logs match criteria.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
