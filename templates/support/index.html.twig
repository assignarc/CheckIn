{% extends 'support/layout.html.twig' %}

{% block support_title %}Manager Overview Guide{% endblock %}

{% block support_content %}
<h2 class="fs-2xl fw-800 text-white mb-2">Manager Overview Guide</h2>
<p class="fs-md text-secondary mb-6 lh-relaxed">
    Welcome to the CenterTime Help Center. This guide outlines how to monitor, configure, and scale your organization's time-tracking operations.
</p>

<div class="support-split-view mb-8">
    <div>
        <h3 class="fs-lg fw-700 text-white mb-3">The Manager Dashboard</h3>
        <p class="fs-sm text-secondary mb-4 lh-relaxed">
            The dashboard is the central command center for your organization. As soon as you log in, you are presented with real-time analytics and live operation controls:
        </p>
        <ul class="fs-sm text-secondary d-flex flex-column gap-2 pl-5 lh-relaxed">
            <li><strong>Active Sessions Count:</strong> Displays the number of employees currently checked into your workplace in real-time.</li>
            <li><strong>Total Sessions Today:</strong> Tracks the cumulative number of check-in and checkout events that have occurred since midnight.</li>
            <li><strong>Active List Grid:</strong> Lists all currently clocked-in users, displaying their check-in category (e.g. Development, Design), start time, and active duration.</li>
        </ul>
    </div>
    <div class="glass-panel p-2 d-flex flex-column align-items-center" style="border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.08); background: rgba(0,0,0,0.2);">
        <img src="{{ asset('img/support/dashboard.png') }}" alt="Manager Dashboard" style="width: 100%; border-radius: var(--radius-xs); height: auto; box-shadow: var(--shadow-md);">
        <span class="fs-xs text-muted mt-2 text-center">Actual Manager Dashboard Screen</span>
    </div>
</div>

<hr class="my-6" style="border: 0; border-top: 1px solid rgba(255,255,255,0.08)">

<h3 class="fs-lg fw-700 text-white mb-4">Real-Time Indicators</h3>
<p class="fs-sm text-secondary mb-0 lh-relaxed">
    The dashboard utilizes automatic updates to display session durations and check-in statuses without manual page reloads. If a manager needs to manually clock out an employee, they can click the <strong>Force Clock Out</strong> button directly from the active session list.
</p>
{% endblock %}
