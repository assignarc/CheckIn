{% extends 'manager/layout.html.twig' %}

{% block title %}Billing & Subscription - CenterTime{% endblock %}
{% block header_title %}Billing & Subscription Management{% endblock %}

{% block manager_content %}
<div class="billing-grid">

    <!-- Left: Subscription Management -->
    <div class="d-flex flex-column gap-8">
        
        <!-- Current Subscription Plan details -->
        <div class="glass-panel" style="padding: 1.75rem;">
            <div class="billing-header">
                <div>
                    <h3 class="fs-xl m-0">Subscription Overview</h3>
                    <p class="fs-sm text-secondary mt-1">
                        {% if org.stripeCustomerId %}
                            Stripe reference ID: <code class="text-break" style="word-break: break-all;">{{ org.stripeCustomerId }}</code>
                        {% else %}
                            Stripe reference ID: <code class="text-break" style="word-break: break-all;">cus_StripeMockTenant_{{ org.id }}</code>
                        {% endif %}
                    </p>
                </div>
                <div class="d-flex flex-column align-items-end gap-2 billing-header-actions">
                    {% set currentPlanName = org.plan.name|lower %}
                    <span class="badge btn-metal-{{ currentPlanName }} fs-sm px-3 py-1 mt-1">
                        {{ org.plan.name|upper }} Plan
                    </span>
                    {% if org.stripeCustomerId %}
                        <a href="{{ path('app_stripe_portal') }}" class="btn btn-xs btn-outline-primary d-flex align-items-center gap-1">
                            <span class="material-icons" style="font-size:12px">open_in_new</span> Stripe Billing Portal
                        </a>
                    {% endif %}
                </div>
            </div>

            <div class="billing-stats-grid mb-8 pt-6 border-t">
                <div>
                    <div class="fs-sm text-uppercase text-muted">Subscription Status</div>
                    <div class="fs-lg fw-700 d-flex align-items-center gap-1 mt-1">
                        {% if org.isSubscriptionActive %}
                            <span class="material-icons fs-xl text-success">check_circle</span>
                            <span class="text-success">Active & Paid</span>
                        {% else %}
                            <span class="material-icons fs-xl text-danger">error</span>
                            <span class="text-danger">Suspended</span>
                        {% endif %}
                    </div>
                </div>
                <div>
                    <div class="fs-sm text-uppercase text-muted">Next Invoice Date</div>
                    <div class="fs-lg fw-700 text-white mt-1">
                        {% if payments|length > 0 %}
                            {{ payments[0].periodEnd|date("M d, Y") }}
                        {% else %}
                            --
                        {% endif %}
                    </div>
                </div>
                <div>
                    <div class="fs-sm text-uppercase text-muted">Upcoming Bill</div>
                    <div class="fs-lg fw-700 text-purple-300 mt-1">
                        {% if org.plan.name != 'basic' %}
                            ${{ org.plan.priceMonthly|round }}
                        {% else %}
                            $0 (Free Plan)
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Subscription Actions -->
            <div class="text-uppercase text-muted d-flex align-items-center gap-1 pt-4 pb-3 fs-xs border-t tracking-wide fw-600">
                <span class="material-icons fs-sm text-primary">card_membership</span> Available Subscription Plans
            </div>
            <div class="d-flex flex-column gap-3">
                {% for p in plans %}
                    {% set pName = p.name|lower %}
                    {% set isCurrent = (org.plan.name|lower == pName) %}
                    {% if pName == 'basic' %}
                        <form method="post" class="w-100 m-0">
                            <input type="hidden" name="plan" value="basic">
                            <input type="hidden" name="billing_action" value="downgrade">
                            <button type="submit" class="btn btn-metal-basic btn-sm w-100 d-flex align-items-center justify-content-center py-2" {% if isCurrent %}disabled style="opacity: 0.6;"{% endif %}>
                                {% if isCurrent %}Current Plan — Basic (Free){% else %}Downgrade to Basic (Free){% endif %}
                            </button>
                        </form>
                    {% else %}
                        <a href="{{ path('app_stripe_checkout', {planName: p.name}) }}" 
                           class="btn btn-metal-{{ pName }} btn-sm w-100 d-flex align-items-center justify-content-center py-2"
                           {% if isCurrent %}style="opacity: 0.6; pointer-events: none;"{% endif %}>
                            {% if isCurrent %}Current Plan — {{ p.name|capitalize }} (${{ p.priceMonthly|round }}/mo){% else %}Upgrade to {{ p.name|capitalize }} (${{ p.priceMonthly|round }}/mo){% endif %}
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <!-- Invoices list -->
        <div class="glass-panel p-6">
            <h3 class="fs-lg mb-5">Payment History</h3>
            
            <div class="table-responsive">
                <table class="table fs-sm">
                    <thead>
                        <tr>
                            <th>Invoice ID</th>
                            <th>Amount</th>
                            <th>Billing Period</th>
                            <th>Paid At</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pay in payments %}
                            <tr>
                                <td class="text-primary font-mono text-break" style="word-break: break-all;">{{ pay.stripeInvoiceId }}</td>
                                <td class="fw-700 text-white">${{ pay.amount }}</td>
                                <td>{{ pay.periodStart|date('M d, Y') }} - {{ pay.periodEnd|date('M d, Y') }}</td>
                                <td>{{ pay.paidAt|date('M d, Y, h:i A') }}</td>
                                <td>
                                    <span class="badge badge-success">{{ pay.status }}</span>
                                </td>
                                <td>
                                    {% if org.stripeCustomerId and not (pay.stripeInvoiceId starts with 'sub_') %}
                                        <a href="{{ path('app_stripe_portal') }}" class="btn btn-xs btn-outline-secondary">
                                            View Receipt
                                        </a>
                                    {% else %}
                                        <span class="text-muted fs-xs">Mock Record</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted p-8" >
                                    <span class="material-icons mb-0" style="font-size: 2.5rem; .5rem">receipt</span>
                                    <p class="fs-sm">No payments registered. (Basic Free plan doesn't trigger invoices).</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Right: Stripe Test Console -->
    <div class="glass-panel p-6" style="height: fit-content; border-color: rgba(239, 68, 68, 0.2)">
        <h3 class="fs-lg text-danger d-flex align-items-center gap-2 mb-2">
            <span class="material-icons">terminal</span> Stripe Sandbox Console
        </h3>
        <p class="fs-sm text-secondary mb-6">
            Simulate webhooks, renewal failures, and dunning workflows to test application behaviors.
        </p>

        <div class="d-flex flex-column gap-3">
            {% if org.isSubscriptionActive %}
                <form method="post" class="w-100">
                    <input type="hidden" name="billing_action" value="fail_payment">
                    <button type="submit" class="btn btn-danger btn-sm w-100">
                        <span class="material-icons fs-lg">credit_card_off</span> Trigger Payment Failure (Lock)
                    </button>
                </form>
            {% else %}
                <form method="post" class="w-100">
                    <input type="hidden" name="billing_action" value="restore_payment">
                    <button type="submit" class="btn btn-success btn-sm w-100">
                        <span class="material-icons fs-lg">replay</span> Resolve Payment (Unlock)
                    </button>
                </form>
            {% endif %}
            
            <div class="fs-xs text-muted mt-0 border-t" style="padding-top:1rem; .5rem">
                <strong>Dunning Escalation workflow:</strong><br>
                1. Stripe payment fails.<br>
                2. Webhook triggers suspension.<br>
                3. Features disable automatically.<br>
                4. Organization metrics retain history but cannot check in/out.
            </div>
        </div>
    </div>

</div>
{% endblock %}
