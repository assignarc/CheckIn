{% extends 'manager/layout.html.twig' %}

{% block title %}Billing & Subscription - CenterTime{% endblock %}
{% block header_title %}Billing & Subscription Management{% endblock %}

{% block manager_content %}
<div class="billing-grid">

    <!-- Left: Subscription Management -->
    <div class="d-flex flex-column gap-8">
        
        <!-- Current Subscription Plan details -->
        <div class="glass-panel" style="padding: 1.75rem;">
            <div class="billing-header">
                <div>
                    <h3 class="fs-xl m-0">Subscription Overview</h3>
                    <p class="fs-sm text-secondary mt-1 m-0">
                        Manage your active plan, view upcoming charges, or switch subscription tiers.
                    </p>
                </div>
                <div class="d-flex flex-column align-items-end gap-2 billing-header-actions">
                    {% set currentPlanName = org.plan.name|lower %}
                    <span class="badge btn-metal-{{ currentPlanName }} fs-sm px-3 py-1 mt-1">
                        {{ org.plan.name|upper }} Plan
                    </span>
                    {% if org.stripeCustomerId %}
                        <a href="{{ path('app_stripe_portal') }}" class="btn btn-xs btn-outline-primary d-flex align-items-center gap-1">
                            <span class="material-icons" style="font-size:12px">open_in_new</span> Billing Portal
                        </a>
                    {% endif %}
                </div>
            </div>

            {% if org.pendingPlan %}
                <div class="mt-4 p-4 rounded-md d-flex align-items-center gap-3" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3);">
                    <span class="material-icons text-warning fs-xl">schedule</span>
                    <div>
                        <strong class="text-warning">Plan Change Scheduled:</strong>
                        <span class="fs-sm text-secondary">
                            Currently active on <strong>{{ org.plan.name|upper }} Plan</strong>. Your account is scheduled to transition to the <strong>{{ org.pendingPlan.name|upper }} Plan</strong> on <strong>{{ org.pendingPlanEffectiveAt|date('M d, Y', org.timezone|default('UTC')) }}</strong>.
                        </span>
                    </div>
                </div>
            {% endif %}

            <div class="billing-stats-grid mb-6 pt-6 border-t">
                <div>
                    <div class="fs-sm text-uppercase text-muted">Subscription Status</div>
                    <div class="fs-lg fw-700 d-flex align-items-center gap-1 mt-1">
                        {% if org.isSubscriptionActive %}
                            <span class="material-icons fs-xl text-success">check_circle</span>
                            <span class="text-success">Active &amp; Paid</span>
                        {% else %}
                            <span class="material-icons fs-xl text-danger">error</span>
                            <span class="text-danger">Suspended</span>
                        {% endif %}
                    </div>
                </div>
                <div>
                    <div class="fs-sm text-uppercase text-muted">Next Invoice Date</div>
                    <div class="fs-lg fw-700 text-white mt-1">
                        {% if org.pendingPlanEffectiveAt %}
                            {{ org.pendingPlanEffectiveAt|date("M d, Y", org.timezone|default('UTC')) }}
                        {% elseif payments|length > 0 and org.plan.name != 'basic' %}
                            {{ payments[0].periodEnd|date("M d, Y", org.timezone|default('UTC')) }}
                        {% else %}
                            --
                        {% endif %}
                    </div>
                </div>
                <div>
                    <div class="fs-sm text-uppercase text-muted">Upcoming Bill</div>
                    <div class="fs-lg fw-700 text-purple-300 mt-1">
                        {% if org.pendingPlan %}
                            {% if org.pendingPlan.name != 'basic' %}${{ org.pendingPlan.priceMonthly|round }}<span class="fs-xs text-muted">/mo (Starting {{ org.pendingPlanEffectiveAt|date('M d', org.timezone|default('UTC')) }})</span>{% else %}$0 (Basic Plan){% endif %}
                        {% elseif org.plan.name != 'basic' %}
                            ${{ org.plan.priceMonthly|round }}<span class="fs-xs text-muted">/mo</span>
                        {% else %}
                            $0 (Free Plan)
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Toggle Plan Comparison Button -->
            <div class="border-t pt-4">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2" id="toggle-comparison-btn" onclick="togglePlanComparison()">
                    <span class="material-icons fs-md">swap_horiz</span>
                    <span id="comparison-btn-text">Change Subscription Plan</span>
                </button>
            </div>
        </div>

        <!-- Collapsible Plan Comparison View (Populated from DB) -->
        <div id="plan-comparison-section" class="glass-panel p-6 d-none">
            <div class="d-flex align-items-center justify-content-between mb-6 pb-4 border-b">
                <div>
                    <h3 class="fs-xl m-0 d-flex align-items-center gap-2">
                        <span class="material-icons text-primary">card_membership</span> Compare &amp; Choose Your Plan
                    </h3>
                    <p class="fs-sm text-secondary mt-1 m-0">Select a plan to upgrade or switch your organization's subscription tier.</p>
                </div>
                <button type="button" class="btn btn-xs btn-secondary" onclick="togglePlanComparison()">
                    <span class="material-icons fs-sm">close</span> Close
                </button>
            </div>

            <div class="grid-cols-2 gap-4">
                {% for p in plans %}
                    {% set pName = p.name|lower %}
                    {% set isCurrent = (org.plan.name|lower == pName) %}
                    <div class="p-5 rounded-md border d-flex flex-column justify-content-between" style="background: var(--bg-card); border-color: {% if isCurrent %}var(--primary){% else %}var(--border-color){% endif %};">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h4 class="fs-lg fw-800 text-uppercase text-primary m-0">{{ p.name }}</h4>
                                {% if isCurrent %}
                                    <span class="badge badge-success fs-xs">Current Plan</span>
                                {% endif %}
                            </div>

                            <div class="fs-2xl fw-800 mb-4">
                                {% if p.priceMonthly == 0 %}
                                    Free
                                {% else %}
                                    ${{ p.priceMonthly|round }}<span class="fs-xs text-muted">/mo</span>
                                {% endif %}
                            </div>

                            <ul class="fs-xs text-secondary d-flex flex-column gap-2 mb-6" style="list-style: none; padding-left: 0;">
                                <li class="d-flex align-items-center gap-2">
                                    <span class="material-icons text-success fs-sm">check</span>
                                    <span>Up to <strong>{{ p.maxOrgUsers|number_format }}</strong> active employees</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <span class="material-icons text-success fs-sm">check</span>
                                    <span>{% if p.maxManagers >= 9999 %}Unlimited{% else %}{{ p.maxManagers }}{% endif %} Manager seats</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <span class="material-icons text-success fs-sm">check</span>
                                    <span>{{ p.sessionLimitHours }}h max shift duration</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <span class="material-icons text-success fs-sm">check</span>
                                    <span>{{ p.retentionDays }} days log history retention</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    {% if p.hasSecureKiosk %}
                                        <span class="material-icons text-success fs-sm">check</span>
                                        <span>Secure PIN Keypad Kiosk</span>
                                    {% else %}
                                        <span class="material-icons text-warning fs-sm">info</span>
                                        <span>Open Select Kiosk mode</span>
                                    {% endif %}
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    {% if p.exportsEnabled %}
                                        <span class="material-icons text-success fs-sm">check</span>
                                        <span>Excel / CSV Exports enabled</span>
                                    {% else %}
                                        <span class="material-icons text-secondary fs-sm" style="opacity:0.4">cancel</span>
                                        <span class="text-muted">No spreadsheet data exports</span>
                                    {% endif %}
                                </li>
                            </ul>
                        </div>

                        <div>
                            {% if isCurrent %}
                                <button type="button" class="btn btn-secondary btn-sm w-100" disabled style="opacity: 0.6;">Current Active Plan</button>
                            {% elseif pName == 'basic' %}
                                <form method="post" class="w-100 m-0" onsubmit="return confirm('Are you sure you want to cancel your paid subscription and downgrade to the Basic (Free) plan?');">
                                    <input type="hidden" name="plan" value="basic">
                                    <button type="submit" class="btn btn-secondary btn-sm w-100">Downgrade to Basic (Free)</button>
                                </form>
                            {% else %}
                                <a href="{{ path('app_stripe_checkout', {planName: p.name}) }}" class="btn btn-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-1">
                                    <span>Select {{ p.name|capitalize }} (${{ p.priceMonthly|round }}/mo)</span>
                                    <span class="material-icons fs-sm">arrow_forward</span>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Invoices & Payment History list -->
        <div class="glass-panel p-6">
            <h3 class="fs-lg mb-5 d-flex align-items-center gap-2">
                <span class="material-icons text-primary">receipt_long</span> Payment History &amp; Receipts
            </h3>
            
            <div class="table-responsive">
                <table class="table fs-sm">
                    <thead>
                        <tr>
                            <th>Description / Note</th>
                            <th>Amount</th>
                            <th>Billing Period</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pay in payments %}
                            <tr>
                                <td class="fw-600 text-primary">
                                    {{ pay.description|default(org.plan.name|capitalize ~ ' Subscription Payment') }}
                                </td>
                                <td class="fw-700 text-white">${{ pay.amount }}</td>
                                <td>
                                    {% if pay.periodStart and pay.periodEnd and pay.amount != '0.00' %}
                                        {{ pay.periodStart|date('M d, Y') }} - {{ pay.periodEnd|date('M d, Y') }}
                                    {% else %}
                                        --
                                    {% endif %}
                                </td>
                                <td>{{ pay.paidAt|date('M d, Y, h:i A') }}</td>
                                <td>
                                    {% if pay.status == 'paid' %}
                                        <span class="badge badge-success">Paid</span>
                                    {% elseif pay.status == 'cancelled' %}
                                        <span class="badge badge-warning">Cancelled</span>
                                    {% else %}
                                        <span class="badge badge-danger">{{ pay.status|capitalize }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if org.stripeCustomerId and not (pay.stripeInvoiceId starts with 'cancel_') and not (pay.stripeInvoiceId starts with 'sub_') %}
                                        <a href="{{ path('app_stripe_portal') }}" class="btn btn-xs btn-outline-secondary d-inline-flex align-items-center gap-1">
                                            <span class="material-icons" style="font-size: 11px;">open_in_new</span> Receipt
                                        </a>
                                    {% else %}
                                        <span class="text-muted fs-xs">System Note</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted p-8">
                                    <span class="material-icons mb-2" style="font-size: 2.5rem; opacity: 0.4;">receipt</span>
                                    <p class="fs-sm m-0">No payment history entries recorded yet.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Right: Stripe Test Console -->
    <div class="glass-panel p-6" style="height: fit-content; border-color: rgba(239, 68, 68, 0.2)">
        <h3 class="fs-lg text-danger d-flex align-items-center gap-2 mb-2">
            <span class="material-icons">terminal</span> Stripe Sandbox Console
        </h3>
        <p class="fs-sm text-secondary mb-6">
            Simulate webhooks, renewal failures, and dunning workflows to test application behaviors.
        </p>

        <div class="d-flex flex-column gap-3">
            {% if org.isSubscriptionActive %}
                <form method="post" class="w-100">
                    <input type="hidden" name="billing_action" value="fail_payment">
                    <button type="submit" class="btn btn-danger btn-sm w-100">
                        <span class="material-icons fs-lg">credit_card_off</span> Trigger Payment Failure (Lock)
                    </button>
                </form>
            {% else %}
                <form method="post" class="w-100">
                    <input type="hidden" name="billing_action" value="restore_payment">
                    <button type="submit" class="btn btn-success btn-sm w-100">
                        <span class="material-icons fs-lg">replay</span> Resolve Payment (Unlock)
                    </button>
                </form>
            {% endif %}
            
            <div class="fs-xs text-muted mt-2 border-t pt-4">
                <strong>Billing Lifecycle:</strong><br>
                • Paid plan signup → Redirect to Stripe Checkout<br>
                • Payment completed → Webhook sets plan &amp; logs invoice<br>
                • Downgrade → Cancels Stripe sub &amp; notifies manager
            </div>
        </div>

</div>

<script>
    function togglePlanComparison() {
        const section = document.getElementById('plan-comparison-section');
        const btnText = document.getElementById('comparison-btn-text');
        if (section.classList.contains('d-none')) {
            section.classList.remove('d-none');
            btnText.textContent = 'Hide Plan Options';
        } else {
            section.classList.add('d-none');
            btnText.textContent = 'Change Subscription Plan';
        }
    }
</script>
{% endblock %}
