{% extends 'manager/layout.html.twig' %}

{% block title %}Audit Logs - CenterTime{% endblock %}
{% block header_title %}Audit Logs{% endblock %}

{% block manager_content %}
<div class="glass-panel p-6">
    <div class="d-flex align-items-center justify-content-between mb-6">
        <h3 class="fs-lg text-purple-300 m-0">Organization Audit Logs</h3>
        <button onclick="window.location.reload();" class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <span class="material-icons">refresh</span> Refresh
        </button>
    </div>

    <div class="table-responsive">
        <table class="table fs-md">
            <thead>
                <tr>
                    <th style="width: 160px;">Timestamp</th>
                    <th style="width: 260px;">Actor / Action</th>
                    <th>Details</th>
                    <th style="width: 120px;">IP Address</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr>
                        <td class="white-space-nowrap align-top">{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td class="align-top" style="min-width: 220px;">
                            <div class="fw-600">
                                {% if log.manager %}
                                    {{ log.manager.firstName }} {{ log.manager.lastName }}
                                    <div class="fs-xs text-muted mb-1">{{ log.manager.email }}</div>
                                {% else %}
                                    <div class="fs-xs text-muted mb-1">System</div>
                                {% endif %}
                            </div>
                            <span class="badge" style="background: rgba(167, 139, 250, 0.15); color: #c4b5fd;">
                                {{ log.action }}
                            </span>
                        </td>
                        <td>
                            {% if log.detailsJson is iterable and log.detailsJson|length > 0 %}
                                <details class="fs-xs">
                                    <summary class="cursor-pointer text-purple-400 fw-600" style="outline: none; list-style: none;">
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <span class="material-icons fs-sm" style="font-size: 0.9rem;">unfold_more</span> Show Details
                                        </span>
                                    </summary>
                                    <div class="d-flex flex-column gap-1 mt-2 border-l pl-3" style="min-width: 220px; border-left: 2px solid var(--border-color);">
                                        {% for key, val in log.detailsJson %}
                                            <div>
                                                <span class="text-secondary fw-600">{{ key|replace({'_': ' '})|title }}:</span>
                                                <span class="text-primary">{{ val is iterable ? val|json_encode : val }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </details>
                            {% else %}
                                <span class="text-muted fs-xs">None</span>
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ log.ipAddress|default('—') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted p-8">
                            No audit logs available.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
