{% extends 'base.html.twig' %}

{% block body %}
<div class="dashboard-layout">
    <!-- Sidebar Navigation -->
    <aside class="sidebar" id="sidebar">
        <a href="{{ path('app_home') }}" class="sidebar-logo text-decoration-none text-inherit" style="display: flex; align-items: center; gap: 8px; color: inherit; text-decoration: none;">
            <img src="{{ asset('img/logo.png') }}?v=1.0.4" alt="CenterTime Logo" style="height: 40px; width: 40px; object-fit: contain;">
            <span>Center<span class="accent">Time</span></span>
        </a>
        
        <nav class="sidebar-nav">
            <a href="{{ path('app_manager_dashboard') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_dashboard' %}active{% endif %}" data-tooltip="Dashboard">
                <span class="material-icons">dashboard</span> <span>Dashboard</span>
            </a>
            <a href="{{ path('app_manager_users_checked_in') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_users_checked_in' %}active{% endif %}" data-tooltip="Checked In Now">
                <span class="material-icons">directions_run</span> <span>Checked In Now</span>
            </a>
            <a href="{{ path('app_manager_users') }}" class="sidebar-link {% if 'app_manager_user' in app.request.attributes.get('_route') and app.request.attributes.get('_route') != 'app_manager_users_checked_in' %}active{% endif %}" data-tooltip="Students & Instructors">
                <span class="material-icons">people</span> <span>Students & Instructors</span>
            </a>
            <a href="{{ path('app_manager_print_barcodes') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_print_barcodes' %}active{% endif %}" data-tooltip="Sticker Badges">
                <span class="material-icons">qr_code_2</span> <span>Sticker Badges</span>
            </a>
            <a href="{{ path('app_manager_categories') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_categories' %}active{% endif %}" data-tooltip="Categories">
                <span class="material-icons">category</span> <span>Categories</span>
            </a>
            <a href="{{ path('app_manager_reports') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_reports' %}active{% endif %}" data-tooltip="Reporting & Logs">
                <span class="material-icons">bar_chart</span> <span>Reporting & Logs</span>
            </a>
            <a href="{{ path('app_manager_reports_by_user') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_reports_by_user' %}active{% endif %}" data-tooltip="Reports by User">
                <span class="material-icons">calendar_month</span> <span>Reports by User</span>
            </a>
            <a href="{{ path('app_manager_settings') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_settings' %}active{% endif %}" data-tooltip="Settings">
                <span class="material-icons">settings</span> <span>Settings</span>
            </a>
            <a href="{{ path('app_manager_audit_logs') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_audit_logs' %}active{% endif %}" data-tooltip="Audit Logs">
                <span class="material-icons">history</span> <span>Audit Logs</span>
            </a>
            <a href="{{ path('app_manager_billing') }}" class="sidebar-link {% if app.request.attributes.get('_route') == 'app_manager_billing' %}active{% endif %}" data-tooltip="Billing & Subscription">
                <span class="material-icons">credit_card</span> <span>Billing & Subscription</span>
            </a>
            <a href="{{ path('app_support_index') }}" target="_blank" class="sidebar-link {% if 'app_support' in app.request.attributes.get('_route') %}active{% endif %}" data-tooltip="Help & Support">
                <span class="material-icons text-primary">help_outline</span> <span>Help & Support</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content Frame -->
    <main class="main-content">
        <!-- Top Header Bar -->
        <header class="dashboard-header">
            <div class="d-flex align-items-center gap-3">
                <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()" aria-label="Toggle sidebar">
                    <span class="material-icons">menu</span>
                </button>
                <h2 class="fs-lg fw-600 m-0">{% block header_title %}Manager Portal{% endblock %}</h2>
            </div>
            
            <div class="header-actions-menu" id="headerActionsMenu">
                <button type="button" class="header-actions-toggle" id="headerActionsToggle" onclick="toggleHeaderMenu()" aria-label="User menu">
                    <div class="user-avatar fs-xs icon-28">{{ app.user.firstName|slice(0, 1) }}{{ app.user.lastName|slice(0, 1) }}</div>
                    <span class="material-icons fs-md">expand_more</span>
                </button>

                <div class="header-actions-dropdown" id="headerActionsDropdown">
                    <!-- User Info -->
                    <div class="header-dropdown-section">
                        <div class="d-flex align-items-center gap-3 p-4">
                            <div class="user-avatar fs-xs icon-36">{{ app.user.firstName|slice(0, 1) }}{{ app.user.lastName|slice(0, 1) }}</div>
                            <div class="lh-sm">
                                <div class="fw-600 fs-sm">{{ app.user.firstName }} {{ app.user.lastName }}</div>
                                <div class="fs-xs text-muted">{{ app.user.organization.name }}</div>
                            </div>
                        </div>
                    </div>

                    <!-- Status Badges -->
                    <div class="header-dropdown-section d-flex align-items-center gap-2 p-3">
                        <span class="badge {% if app.user.organization.plan.name == 'gold' %}badge-success{% elseif app.user.organization.plan.name == 'silver' %}badge-info{% else %}badge-warning{% endif %}">
                            {{ app.user.organization.plan.name|capitalize }} Plan
                        </span>
                        {% if not app.user.organization.isSubscriptionActive %}
                            <span class="badge badge-danger">Payment Overdue</span>
                        {% endif %}
                    </div>

                    <!-- Theme Selector -->
                    <div class="header-dropdown-section p-3 d-flex align-items-center justify-content-between gap-3">
                        <span class="fs-xs text-muted">Theme</span>
                        <div class="theme-selector">
                            <button type="button" class="theme-option" data-value="light" onclick="setTheme('light')" title="Light Mode">
                                <span class="material-icons">light_mode</span>
                            </button>
                            <button type="button" class="theme-option" data-value="dark" onclick="setTheme('dark')" title="Dark Mode">
                                <span class="material-icons">dark_mode</span>
                            </button>
                            <button type="button" class="theme-option" data-value="system" onclick="setTheme('system')" title="System Theme">
                                <span class="material-icons">settings_brightness</span>
                            </button>
                        </div>
                    </div>

                    <!-- Action Links -->
                    <div class="header-dropdown-section">
                        <a href="{{ path('app_manager_dashboard') }}" class="header-dropdown-item">
                            <span class="material-icons fs-lg text-primary">dashboard</span>
                            <span>Dashboard</span>
                        </a>
                        <a href="{{ path('app_support_index') }}" target="_blank" class="header-dropdown-item">
                            <span class="material-icons fs-lg text-info">help</span>
                            <span>Help Center</span>
                        </a>
                        <a href="/org/{{ app.user.organization.slug }}/kiosk/{{ app.user.organization.checkInLinkToken }}" target="_blank" class="header-dropdown-item">
                            <span class="material-icons fs-lg text-primary">tablet_mac</span>
                            <span>Launch Kiosk</span>
                        </a>
                        <a href="{{ path('app_manager_settings') }}" class="header-dropdown-item">
                            <span class="material-icons fs-lg text-muted">settings</span>
                            <span>Settings</span>
                        </a>
                        <a href="{{ path('app_logout') }}" class="header-dropdown-item text-danger" data-turbo="false">
                            <span class="material-icons fs-lg">logout</span>
                            <span>Sign Out</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <div class="dashboard-body flex-1">
            {% if app.user.organization.isArchived %}
                <div class="alert alert-danger mb-6">
                    <span class="material-icons">archive</span>
                    <span><strong>Organization Archived:</strong> Your account is currently in archive mode due to unpaid invoices. Check-in kiosks and registry updates are disabled. Please update your billing details on this page to resume service.</span>
                </div>
            {% endif %}

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}">
                        <span class="material-icons">
                            {% if type == 'danger' %}error{% elseif type == 'warning' %}warning{% else %}check_circle{% endif %}
                        </span>
                        <span>{{ message|raw }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block manager_content %}{% endblock %}
        </div>
    </main>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Ticking Active Sessions Timer Functionality
        function updateTickingTimers() {
            const timers = document.querySelectorAll('.ticking-timer');
            const now = new Date();
            
            timers.forEach(timer => {
                const startedAtStr = timer.getAttribute('data-started-at');
                const maxSeconds = parseInt(timer.getAttribute('data-max-seconds') || '0', 10);
                if (!startedAtStr) return;
                
                const startedAt = new Date(startedAtStr);
                const diffSecs = Math.floor((now - startedAt) / 1000);
                
                const textEl = timer.querySelector('.timer-text');
                const dot = timer.querySelector('.timer-dot');
                
                if (diffSecs >= maxSeconds) {
                    // Over limit
                    timer.classList.remove('badge-success');
                    timer.classList.add('badge-danger');
                    timer.style.background = 'var(--danger-glow)';
                    timer.style.color = 'var(--danger)';
                    if (dot) {
                        dot.style.display = 'inline-block';
                        dot.style.backgroundColor = 'var(--danger)';
                    }
                } else {
                    // Normal under limit
                    timer.classList.add('badge-success');
                    timer.classList.remove('badge-danger', 'badge-secondary');
                    timer.style.background = 'var(--success-glow)';
                    timer.style.color = 'var(--success)';
                    if (dot) {
                        dot.style.display = 'inline-block';
                        dot.style.backgroundColor = 'var(--success)';
                    }
                }
                
                const hours = Math.floor(diffSecs / 3600);
                const minutes = Math.floor((diffSecs % 3600) / 60);
                const seconds = diffSecs % 60;
                
                const formatted = 
                    String(hours).padStart(2, '0') + ':' + 
                    String(minutes).padStart(2, '0') + ':' + 
                    String(seconds).padStart(2, '0');
                
                if (textEl) {
                    textEl.textContent = formatted;
                }
            });
        }
        
        updateTickingTimers();
        setInterval(updateTickingTimers, 1000);
    });

    // Restore sidebar collapse state immediately on load
    if (window.innerWidth > 900 && localStorage.getItem('sidebar-collapsed') === '1') {
        const layout = document.querySelector('.dashboard-layout');
        if (layout) {
            layout.classList.add('sidebar-collapsed');
        }
        const icon = document.querySelector('#sidebarToggle .material-icons');
        if (icon) {
            icon.textContent = 'menu_open';
        }
    }

    function toggleSidebar() {
        const layout = document.querySelector('.dashboard-layout');
        const icon = document.querySelector('#sidebarToggle .material-icons');
        
        if (window.innerWidth <= 900) {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('sidebar-open');
        } else {
            layout.classList.toggle('sidebar-collapsed');
            const isCollapsed = layout.classList.contains('sidebar-collapsed');
            localStorage.setItem('sidebar-collapsed', isCollapsed ? '1' : '0');
            
            // Toggle hamburger icon between menu and menu_open
            if (icon) {
                icon.textContent = isCollapsed ? 'menu_open' : 'menu';
            }
        }
    }

    function toggleHeaderMenu() {
        const dropdown = document.getElementById('headerActionsDropdown');
        dropdown.classList.toggle('open');
    }

    // Close sidebar and header menu when clicking outside
    document.addEventListener('click', function(e) {
        const sidebar = document.getElementById('sidebar');
        const toggle = document.getElementById('sidebarToggle');
        if (window.innerWidth <= 900 && sidebar.classList.contains('sidebar-open')
            && !sidebar.contains(e.target) && !toggle.contains(e.target)) {
            sidebar.classList.remove('sidebar-open');
        }

        // Close header dropdown when clicking outside
        const menu = document.getElementById('headerActionsMenu');
        const dropdown = document.getElementById('headerActionsDropdown');
        if (dropdown && dropdown.classList.contains('open') && !menu.contains(e.target)) {
            dropdown.classList.remove('open');
        }
    });
</script>
{% endblock %}
