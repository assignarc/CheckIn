{% extends 'manager/layout.html.twig' %}

{% block manager_title %}Reports by User{% endblock %}

{% block manager_content %}
    <!-- Header & Filter Bar -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-4 mb-8">
        <div>
            <h2 class="mb-1">Reports by User</h2>
            <p class="text-secondary m-0">View check-in activity for a specific user.</p>
        </div>
        
        <form method="get" class="d-flex align-items-center gap-4">
            <input type="hidden" name="month" value="{{ currentMonth }}">
            
            <div class="m-0" style="min-width: 200px">
                <select name="org_user_id" id="org_user_id" class="form-control" onchange="this.form.submit()">
                    <option value="">-- Select a User --</option>
                    {% for u in orgUsers %}
                        <option value="{{ u.id }}" {% if selectedUser and selectedUser.id == u.id %}selected{% endif %}>
                            {{ u.firstName }} {{ u.lastName }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            
            <noscript>
                <button type="submit" class="btn btn-primary">Load</button>
            </noscript>
            
            <a href="{{ path('app_manager_reports') }}" class="btn btn-secondary" title="Back to List">
                <span class="material-icons">list</span>
            </a>
        </form>
    </div>

    {% if selectedUser %}
        {% set totalHours = (totalMonthSeconds / 3600)|round(0, 'floor') %}
        {% set totalMins = ((totalMonthSeconds % 3600) / 60)|round(0, 'floor') %}
        
        <div class="d-flex align-items-center justify-content-between mb-6">
            <a href="?org_user_id={{ selectedUser.id }}&month={{ prevMonth }}" class="btn btn-secondary" >
                <span class="material-icons fs-xl">chevron_left</span> Prev
            </a>
            <div class="text-center">
                <h3 class="m-0 mb-0" >{{ monthName }}</h3>
                <span class="fs-md fw-500 text-secondary">
                    Total Time: <strong class="text-primary">{{ totalHours }}h {{"%02d"|format(totalMins) }}m</strong>
                </span>
            </div>
            <a href="?org_user_id={{ selectedUser.id }}&month={{ nextMonth }}" class="btn btn-secondary" >
                Next <span class="material-icons fs-xl">chevron_right</span>
            </a>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="fs-md text-secondary m-0">Daily Check-ins</h4>
            
            <!-- Highlight Filter UI -->
            <div class="d-flex align-items-center gap-2">
                <span class="fs-sm text-secondary fw-500">Highlight ></span>
                <button type="button" class="btn btn-sm btn-outline-secondary highlight-filter-btn" data-seconds="1800">30m</button>
                <button type="button" class="btn btn-sm btn-outline-secondary highlight-filter-btn" data-seconds="2700">45m</button>
                <button type="button" class="btn btn-sm btn-outline-secondary highlight-filter-btn" data-seconds="3600">1h</button>
                
                <div class="d-flex align-items-center gap-1 ms-2">
                    <input type="number" id="custom-highlight-mins" class="form-control form-control-sm" style="width: 70px" placeholder="Mins" min="1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="highlight-custom-btn">Apply</button>
                </div>
                
                <button type="button" class="btn btn-sm btn-ghost ms-2 text-danger" id="highlight-clear-btn" style="display:none;">Clear</button>
            </div>
        </div>

        <div class="bg-card rounded-lg border">
            <!-- Calendar Header -->
            <div class="fs-sm fw-600 text-center text-secondary bg-input d-grid border-b calendar-header">
                <div>Sun</div>
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div>Fri</div>
                <div>Sat</div>
            </div>
            
            <!-- Calendar Grid -->
            <div class="d-grid calendar-grid">
                {# Padding for start day of week #}
                {% for i in 0..(startDayOfWeek - 1) %}
                    {% if startDayOfWeek > 0 and i < startDayOfWeek %}
                        <div class="border-b calendar-cell-empty"></div>
                    {% endif %}
                {% endfor %}

                {# Days #}
                {% for key, dayData in calendarData %}
                    <div class="border-b calendar-cell">
                        <div class="d-flex justify-content-between mb-0 calendar-cell-header">
                            <span class="fs-md fw-600 text-primary">{{ dayData.day }}</span>
                            {% if dayData.totalSeconds > 0 %}
                                {% set hours = (dayData.totalSeconds / 3600)|round(0, 'floor') %}
                                {% set mins = ((dayData.totalSeconds % 3600) / 60)|round(0, 'floor') %}
                                <span class="badge-daily-total">
                                    {{ hours }}h{{"%02d"|format(mins) }}m
                                </span>
                            {% endif %}
                        </div>

                        <div class="d-flex flex-column gap-1">
                            {% for session in dayData.sessions %}
                                {% set sHours = (session.durationSeconds / 3600)|round(0, 'floor') %}
                                {% set sMins = ((session.durationSeconds % 3600) / 60)|round(0, 'floor') %}
                                {% set catColor = session.category ? session.category.color : 'var(--primary)' %}
                                {% set catName = session.category ? session.category.name : 'None' %}
                                {% set timeRange = session.startedAt|date('H:i') ~ ' - ' ~ (session.endedAt ? session.endedAt|date('H:i') : 'Now') %}
                                
                                {% set sessionDurationSeconds = session.durationSeconds|default(0) %}
                                <div class="fw-600 d-inline-flex align-items-center justify-content-center rounded position-relative custom-popover-trigger calendar-session highlightable-session" 
                                     style="border-left: 4px solid {{ catColor }};" data-duration="{{ sessionDurationSeconds }}">
                                    {{ sHours }}h{{"%02d"|format(sMins) }}m
                                    
                                    <div class="custom-popover-content shadow-lg rounded p-2" style="border-top: 3px solid {{ catColor }};">
                                        <div class="fw-bold mb-1">{{ catName }}</div>
                                        <div class="text-muted calendar-session-popover-text">{{ timeRange }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
                
                {# Padding for end of grid #}
                {% set totalCells = startDayOfWeek + daysInMonth %}
                {% set remainingCells = (7 - (totalCells % 7)) % 7 %}
                {% for i in 0..(remainingCells - 1) %}
                    {% if remainingCells > 0 %}
                        <div class="border-b calendar-cell-empty"></div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="text-center text-muted bg-card rounded-md empty-state-card">
            <span class="material-icons fs-4xl mb-4">person_search</span>
            <p>Please select a user from the dropdown above to view their check-in calendar.</p>
        </div>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Highlight logic
            const sessionElements = document.querySelectorAll('.highlightable-session');
            const clearBtn = document.getElementById('highlight-clear-btn');
            const customBtn = document.getElementById('highlight-custom-btn');
            const customInput = document.getElementById('custom-highlight-mins');
            
            function applyHighlight(minSeconds) {
                sessionElements.forEach(el => {
                    const duration = parseInt(el.getAttribute('data-duration') || 0, 10);
                    if (duration > minSeconds) {
                        el.classList.add('session-highlight');
                        el.classList.remove('session-dimmed');
                    } else {
                        el.classList.remove('session-highlight');
                        el.classList.add('session-dimmed');
                    }
                });
                clearBtn.style.display = 'inline-block';
            }
            
            function clearHighlight() {
                sessionElements.forEach(el => {
                    el.classList.remove('session-highlight', 'session-dimmed');
                });
                clearBtn.style.display = 'none';
                customInput.value = '';
            }
            
            document.querySelectorAll('.highlight-filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    applyHighlight(parseInt(this.getAttribute('data-seconds'), 10));
                });
            });
            
            if (customBtn) {
                customBtn.addEventListener('click', function() {
                    const mins = parseInt(customInput.value, 10);
                    if (!isNaN(mins) && mins > 0) {
                        applyHighlight(mins * 60);
                    }
                });
            }
            
            if (clearBtn) {
                clearBtn.addEventListener('click', clearHighlight);
            }
        });
    </script>
{% endblock %}


{% block stylesheets %}
{{ parent() }}

{% endblock %}
