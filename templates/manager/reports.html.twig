{% extends 'manager/layout.html.twig' %}

{% block title %}Reporting & Logs - CenterTime{% endblock %}
{% block header_title %}Timesheets & Reporting Logs{% endblock %}

{% block manager_content %}
<!-- Search & Filter Card -->
<div class="glass-panel mb-8 p-6">
    <form method="get" class="report-filters-grid mb-6">
        <div class="form-group m-0">
            <label class="form-label" for="start_date">Start Date</label>
            <input type="date" name="start_date" id="start_date" class="form-control" value="{{ app.request.query.get('start_date') }}">
        </div>

        <div class="form-group m-0">
            <label class="form-label" for="end_date">End Date</label>
            <input type="date" name="end_date" id="end_date" class="form-control" value="{{ app.request.query.get('end_date') }}">
        </div>

        <div class="form-group m-0">
            <label class="form-label" for="orgUser_filter">User</label>
            <select name="org_user_id" id="orgUser_filter" class="form-control">
                <option value="">All Users</option>
                {% for emp in orgUsers %}
                    <option value="{{ emp.id }}" {% if app.request.query.get('org_user_id') == emp.id %}selected{% endif %}>{{ emp.firstName }} {{ emp.lastName }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group m-0">
            <label class="form-label" for="category_filter">Category</label>
            <select name="category_id" id="category_filter" class="form-control">
                <option value="">All Categories</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {% if app.request.query.get('category_id') == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="d-flex gap-2">
            <a href="{{ path('app_manager_reports_by_user') }}" class="btn btn-secondary"  title="Calendar View by User">
                <span class="material-icons">calendar_month</span>
            </a>
            <button type="submit" class="btn btn-primary" >
                <span class="material-icons">filter_alt</span> Filter
            </button>
            <a href="{{ path('app_manager_reports') }}" class="btn btn-secondary"  title="Reset filters">
                <span class="material-icons">restart_alt</span>
            </a>
        </div>
    </form>
</div>

<!-- Summaries & Exports Row -->
<div class="grid-cols-4 mb-8">
    <div class="metric-card p-4" >
        <div class="metric-icon indigo"><span class="material-icons fs-xl">timer</span></div>
        <div class="metric-info">
            <h3 class="fs-xl">{{ totalHours }}</h3>
            <p class="fs-xs">Total Hours Worked</p>
        </div>
    </div>
    
    <div class="metric-card p-4" >
        <div class="metric-icon rose"><span class="material-icons fs-xl">more_time</span></div>
        <div class="metric-info">
            <h3 class="fs-xl">{{ overtimeCount }}</h3>
            <p class="fs-xs">Overtime Instances</p>
        </div>
    </div>

    <div class="metric-card p-4" >
        <div class="metric-icon amber"><span class="material-icons fs-xl">warning</span></div>
        <div class="metric-info">
            <h3 class="fs-xl">{{ outOfWindowCount }}</h3>
            <p class="fs-xs">Out-of-Window Logs</p>
        </div>
    </div>

    <!-- Export Action Card (gated by subscription limits) -->
    <div class="glass-panel d-flex align-items-center justify-content-center p-0" >
        {% if limitsData.limits.exports %}
            <a href="{{ path('app_manager_reports_export', app.request.query.all) }}" class="btn btn-success btn-sm fs-sm w-100" >
                <span class="material-icons fs-lg">download</span> Export Spreadsheet (CSV)
            </a>
        {% else %}
            <div class="text-center w-100">
                <button type="button" class="btn btn-secondary btn-sm fs-sm w-100 p-2 btn-disabled-visual" title="Exporting is disabled on the Basic plan. Upgrade to Silver or Gold to unlock.">
                    <span class="material-icons fs-lg text-danger">lock</span> Export Locked
                </button>
                <div class="fs-xs text-muted mt-0" >Upgrade to Silver or Gold to export</div>
            </div>
        {% endif %}
    </div>
</div>

<!-- Logs Table -->
<div class="glass-panel p-6">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h3 class="fs-lg m-0">Shift Logs</h3>
        
        <!-- Highlight Filter UI -->
        <div class="d-flex align-items-center gap-2">
            <span class="fs-sm text-secondary fw-500">Highlight ></span>
            <button type="button" class="btn btn-sm btn-outline-secondary highlight-filter-btn" data-seconds="1800">30m</button>
            <button type="button" class="btn btn-sm btn-outline-secondary highlight-filter-btn" data-seconds="2700">45m</button>
            <button type="button" class="btn btn-sm btn-outline-secondary highlight-filter-btn" data-seconds="3600">1h</button>
            
            <div class="d-flex align-items-center gap-1 ms-2">
                <input type="number" id="custom-highlight-mins" class="form-control form-control-sm w-70px" placeholder="Mins" min="1">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="highlight-custom-btn">Apply</button>
            </div>
            
            <button type="button" class="btn btn-sm btn-ghost ms-2 text-danger" id="highlight-clear-btn" style="display:none;">Clear</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Category</th>
                    <th>Started At</th>
                    <th>Ended At</th>
                    <th>Total Worked</th>
                    <th>Verif. Mode</th>
                    <th>Violations / Alerts</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                {% for session in sessions %}
                    <tr class="highlightable-session" data-duration="{{ session.durationSeconds|default(0) }}">
                        <td class="fw-600">{{ session.orgUser.firstName }} {{ session.orgUser.lastName }}</td>
                        <td>
                            <span class="d-inline-flex align-items-center gap-1">
                                <span class="material-icons fs-md text-secondary">
                                    {{ session.category.icon|default('work') }}
                                </span>
                                {{ session.category.name|default('General') }}
                            </span>
                        </td>
                        <td>{{ session.startedAt|date('Y-m-d h:i A') }}</td>
                        <td>
                            {% if session.endedAt %}
                                {{ session.endedAt|date('Y-m-d h:i A') }}
                            {% else %}
                                {% if org.plan.name != 'basic' and session.category and session.category.maxSessionDurationMinutes is not null %}
                                    {% set maxDurationSeconds = session.category.maxSessionDurationMinutes * 60 %}
                                {% else %}
                                    {% set maxDurationSeconds = org.sessionLimitHours * 3600 %}
                                {% endif %}

                                {% set shouldTerminate = false %}
                                {% if org.plan.name == 'basic' %}
                                    {% set shouldTerminate = true %}
                                {% elseif session.category and session.category.terminateAtMaxDuration %}
                                    {% set shouldTerminate = true %}
                                {% endif %}

                                <span class="badge badge-success ticking-timer fs-sm d-inline-flex align-items-center gap-2 tracking-wide" 
                                      data-started="{{ session.startedAt|date('c') }}" 
                                      data-max-duration="{{ maxDurationSeconds }}"
                                      data-terminate="{{ shouldTerminate ? 'true' : 'false' }}"
                                      style="font-family: monospace; padding: 0.35rem 0.6rem; text-transform: none;" 
                                      title="Active Session">
                                    <span class="ticking-dot"></span>
                                    <span class="timer-text">00:00:00</span>
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if session.durationSeconds %}
                                {% set hours = (session.durationSeconds / 3600)|round(0, 'floor') %}
                                {% set mins = ((session.durationSeconds % 3600) / 60)|round(0, 'floor') %}
                                {{ hours }}h {{ mins }}m
                            {% else %}
                                --
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge-info">{{ session.startMethod }}</span>
                        </td>
                        <td>
                            {% if session.endMethod == 'Auto End' or session.endMethod == 'Force End' %}
                                <span class="badge badge-danger">{{ session.endMethod }}</span>
                            {% else %}
                                {% if session.isOvertime %}
                                    <span class="badge badge-danger mr-1">Overtime</span>
                                {% endif %}
                                {% if session.isOutOfWindow %}
                                    <span class="badge badge-warning">Out of Window</span>
                                {% endif %}
                                {% if not session.isOvertime and not session.isOutOfWindow %}
                                    <span class="fs-sm text-muted">Normal</span>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td>
                            {% if not session.endedAt %}
                                <form action="{{ path('app_manager_reports_force_end', {id: session.id}) }}" method="post" style="display:inline;">
                                    <button type="button" class="btn btn-danger btn-sm force-end-btn px-2 py-1" title="Force End Session">
                                        <span class="material-icons fs-sm">stop_circle</span> Stop
                                    </button>
                                </form>
                            {% else %}
                                <div class="fs-xs text-secondary" style="max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap" title="{{ session.deviceInfo }}">
                                    {{ session.deviceInfo|default('N/A') }}
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted empty-state-padding">
                            <span class="material-icons fs-4xl mb-2">find_in_page</span>
                            <p class="fs-sm">No time logs match the selected filter parameters.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Ticking timer logic
        function updateTickingTimers() {
            document.querySelectorAll('.ticking-timer').forEach(timer => {
                const startedStr = timer.getAttribute('data-started');
                const started = new Date(startedStr).getTime();
                const now = Date.now();
                const diffMs = now - started;
                if (diffMs < 0) {
                    timer.querySelector('.timer-text').textContent = '00:00:00';
                    return;
                }
                const diffSecs = Math.floor(diffMs / 1000);
                const hrs = Math.floor(diffSecs / 3600);
                const mins = Math.floor((diffSecs % 3600) / 60);
                const secs = diffSecs % 60;
                
                const hrsStr = hrs.toString().padStart(2, '0');
                const minsStr = mins.toString().padStart(2, '0');
                const secsStr = secs.toString().padStart(2, '0');
                
                timer.querySelector('.timer-text').textContent = `${hrsStr}:${minsStr}:${secsStr}`;
            });
        }
        updateTickingTimers();
        setInterval(updateTickingTimers, 1000);

        document.querySelectorAll('.force-end-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const form = this.closest('form');
                $.confirm({
                    title: 'Force End Session?',
                    content: 'Are you sure you want to forcefully end this session? This action cannot be undone.',
                    type: 'red',
                    theme: 'modern',
                    buttons: {
                        confirm: {
                            text: 'Stop Session',
                            btnClass: 'btn-red',
                            action: function () {
                                form.submit();
                            }
                        },
                        cancel: function () {
                            // do nothing
                        }
                    }
                });
            });
        });
        
        // Highlight logic
        const sessionElements = document.querySelectorAll('.highlightable-session');
        const clearBtn = document.getElementById('highlight-clear-btn');
        const customBtn = document.getElementById('highlight-custom-btn');
        const customInput = document.getElementById('custom-highlight-mins');
        
        function applyHighlight(minSeconds) {
            sessionElements.forEach(el => {
                const duration = parseInt(el.getAttribute('data-duration') || 0, 10);
                if (duration > minSeconds) {
                    el.classList.add('session-highlight');
                    el.classList.remove('session-dimmed');
                } else {
                    el.classList.remove('session-highlight');
                    el.classList.add('session-dimmed');
                }
            });
            clearBtn.style.display = 'inline-block';
        }
        
        function clearHighlight() {
            sessionElements.forEach(el => {
                el.classList.remove('session-highlight', 'session-dimmed');
            });
            clearBtn.style.display = 'none';
            customInput.value = '';
        }
        
        document.querySelectorAll('.highlight-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                applyHighlight(parseInt(this.getAttribute('data-seconds'), 10));
            });
        });
        
        customBtn.addEventListener('click', function() {
            const mins = parseInt(customInput.value, 10);
            if (!isNaN(mins) && mins > 0) {
                applyHighlight(mins * 60);
            }
        });
        
        clearBtn.addEventListener('click', clearHighlight);
    });
</script>
{% endblock %}
