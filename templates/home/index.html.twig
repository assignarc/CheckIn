{% extends 'base.html.twig' %}

{% block title %}TimeFlow - Multi-Tenant Time Tracking & Check-In Platform{% endblock %}
{% block stylesheets %}

    
{% endblock %}

{% block body %}
<header class="dashboard-header" style="z-index: 100;">
    <div class="d-flex align-items-center gap-3">
        <span class="material-icons fs-3xl text-primary">alarm</span>
        <h1 class="fs-2xl fw-800 m-0" style="letter-spacing: -0.02em">TimeFlow</h1>
    </div>
    <div class="d-flex align-items-center gap-4">
        <div class="theme-selector">
            <button type="button" class="theme-option" data-value="light" onclick="setTheme('light')" title="Light Mode">
                <span class="material-icons">light_mode</span>
            </button>
            <button type="button" class="theme-option" data-value="dark" onclick="setTheme('dark')" title="Dark Mode">
                <span class="material-icons">dark_mode</span>
            </button>
            <button type="button" class="theme-option" data-value="system" onclick="setTheme('system')" title="System Theme">
                <span class="material-icons">settings_brightness</span>
            </button>
        </div>
        <a href="{{ path('app_login') }}" class="btn btn-secondary fs-sm" >Login</a>
        {% if new_signups_enabled %}
            <a href="{{ path('app_signup') }}" class="btn btn-primary fs-sm" >Start Free Trial</a>
        {% else %}
            <button class="btn btn-primary fs-sm" disabled style="opacity: 0.6; cursor: not-allowed;">Signups Closed</button>
        {% endif %}
    </div>
</header>

<!-- Main Container -->
<main class="app-container d-flex flex-column home-main-container">
    
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} mb-6">
                <span class="material-icons">
                    {% if type == 'danger' %}error{% else %}check_circle{% endif %}
                </span>
                <span>{{ message|raw }}</span>
            </div>
        {% endfor %}
    {% endfor %}
    
    <!-- Hero Section -->
    <section class="hero-grid align-items-center gap-16 reveal">
        <div>
            <div class="d-inline-flex align-items-center gap-2 mb-6 p-0 rounded-full" style="padding: .35rem 1rem; background: var(--primary-glow); border: 1px solid rgba(99,102,241,0.2)">
                <span class="material-icons fs-md text-primary">bolt</span>
                <span class="fs-sm fw-600 text-uppercase text-indigo-200 tracking-wide">Multi-Tenant Time Kiosk</span>
            </div>
            <h1 class="fs-5xl mb-6" style="line-height: 1.15; letter-spacing: -0.03em">
                Next-Gen <span class="text-gradient">Time Tracking</span><br>For Modern Teams.
            </h1>
            <p class="fs-lg text-secondary mb-10 max-w-600" style="line-height: 1.6">
                Streamline user check-ins with secure PIN entries, custom data fields, customizable time windows, and robust manager-level reporting. Built to scale with multi-tenant logical separation.
            </p>
            <div class="d-flex flex-wrap gap-4">
                {% if new_signups_enabled %}
                    <a href="{{ path('app_signup') }}" class="btn btn-primary fs-lg" >
                        Create Organization <span class="material-icons">arrow_forward</span>
                    </a>
                {% else %}
                    <button class="btn btn-primary fs-lg" disabled style="opacity: 0.6; cursor: not-allowed;">
                        Registration Closed
                    </button>
                {% endif %}
                <a href="{{ path('app_demo') }}" class="btn btn-secondary fs-lg">
                    Request Live Demo
                </a>
            </div>
        </div>
        
        <div class="glass-panel d-flex flex-column gap-6 p-8">
            <h3 class="fs-xl d-flex align-items-center gap-2 mb-2">
                <span class="material-icons text-primary">tablet_mac</span> Interactive Kiosk Preview
            </h3>
            <div class="text-center bg-input p-5 rounded-md border" style="zoom: 0.7;">
                <div class="fs-sm text-uppercase text-muted mb-2">Acme Corp Check-In</div>
                <div class="fs-2xl fw-700 mb-4">Enter Security PIN</div>
                <div class="d-flex justify-content-center gap-3 mb-5">
                    <div class="pin-dot filled"></div>
                    <div class="pin-dot filled"></div>
                    <div class="pin-dot"></div>
                    <div class="pin-dot"></div>
                </div>
                <div class="pin-grid">
                    <div class="pin-btn pin-btn-special">A</div>
                    <div class="pin-btn pin-btn-special">B</div>
                    <div class="pin-btn pin-btn-special">C</div>
                    <div class="pin-btn">1</div>
                    <div class="pin-btn">2</div>
                    <div class="pin-btn">3</div>
                    <div class="pin-btn">4</div>
                    <div class="pin-btn">5</div>
                    <div class="pin-btn">6</div>
                    <div class="pin-btn">7</div>
                    <div class="pin-btn">8</div>
                    <div class="pin-btn">9</div>
                    <div class="pin-btn pin-btn-clear" style="font-size: 0.9rem;">Clear</div>
                    <div class="pin-btn">0</div>
                    <div class="pin-btn"><span class="material-icons">backspace</span></div>
                </div>
            </div>
            <p class="fs-sm text-center text-secondary m-0">
                Kiosk can be locked with a 4-char PIN or toggleable open list mode.
            </p>
        </div>
    </section>

    <!-- Key Platform Benefits Section -->
    <section class="d-flex flex-column gap-12 reveal">
        <div class="text-center">
            <h2 class="fs-3xl">Engineered for <span class="text-gradient">Precision</span> and Control</h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                TimeFlow provides managers with high-fidelity control over shifts logs, auditing, and compliance constraints.
            </p>
        </div>

        <div class="grid-cols-3 gap-6 mb-6">
            <div class="glass-panel p-6">
                <span class="material-icons text-primary mb-4 fs-3xl">gavel</span>
                <h4 class="fs-lg mb-2">Time Window Enforcement</h4>
                <p class="fs-md text-secondary lh-base">
                    Set specific windows for clocking in and out (including overnight shifts support) and automatically flag violations in manager dashboards.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-success mb-4 fs-3xl">cloud_sync</span>
                <h4 class="fs-lg mb-2">Onboarding & Fuzzy Matching</h4>
                <p class="fs-md text-secondary lh-base">
                    Upload existing rosters via CSV. Map custom columns and run fuzzy matching checks to prevent duplicates while merging updates.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-warning mb-4 fs-3xl">security</span>
                <h4 class="fs-lg mb-2">Anti-Brute Force Lockout</h4>
                <p class="fs-md text-secondary lh-base">
                    Protects the workplace kiosk by automatically locking user accounts after 3 incorrect PIN attempts. Managers can clear blocks in a click.
                </p>
            </div>
        </div>
        <div class="grid-cols-3 gap-6">
            <div class="glass-panel p-6">
                <span class="material-icons text-info mb-4 fs-3xl">category</span>
                <h4 class="fs-lg mb-2">Custom Category Limits</h4>
                <p class="fs-md text-secondary lh-base">
                    Override organization-wide limits with custom max session durations per category, giving you granular control.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-indigo mb-4 fs-3xl">payments</span>
                <h4 class="fs-lg mb-2">Advanced Overtime Rules</h4>
                <p class="fs-md text-secondary lh-base">
                    Configure overtime multipliers and grace periods to accurately track and calculate shift overages.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-danger mb-4 fs-3xl">verified_user</span>
                <h4 class="fs-lg mb-2">Math Captcha Security</h4>
                <p class="fs-md text-secondary lh-base">
                    Built-in mathematical captchas on sensitive operations to prevent automated abuse and enhance platform security.
                </p>
            </div>
        </div>
    </section>
    <!-- Spreadsheet Onboarding Wizard Section -->
    <section class="d-flex flex-column gap-12 mt-12 mb-12 reveal">
        <div class="text-center">
            <h2 class="fs-3xl">Streamlined <span class="text-gradient">Spreadsheet Onboarding</span></h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                Move your users from legacy systems to TimeFlow instantly using our high-fidelity CSV mapping tool.
            </p>
        </div>

        <div class="grid-cols-2 gap-8 align-items-center">
            <!-- Left Side: Interactive Mockup of mapping columns -->
            <div class="glass-panel p-6">
                <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-b">
                    <div class="d-flex align-items-center gap-2">
                        <span class="material-icons text-primary">view_week</span>
                        <span class="fs-sm fw-700 text-indigo-200 text-uppercase tracking-wider">CSV Header Mapping</span>
                    </div>
                    <span class="badge bg-primary-glow text-primary fs-xs fw-700">Step 2 of 5</span>
                </div>

                <div class="d-flex flex-column gap-4">
                    <!-- Mapping Card 1 -->
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-sm bg-input border">
                        <div>
                            <span class="fs-xs text-secondary d-block">CSV Column Header</span>
                            <span class="fs-sm fw-700">user_first_name</span>
                        </div>
                        <span class="material-icons text-secondary">trending_flat</span>
                        <div style="text-align: right;">
                            <span class="fs-xs text-secondary d-block">TimeFlow Property</span>
                            <span class="badge bg-success-glow text-success fs-xs fw-600">First Name <span class="material-icons fs-xs align-middle">check</span></span>
                        </div>
                    </div>

                    <!-- Mapping Card 2 -->
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-sm bg-input border">
                        <div>
                            <span class="fs-xs text-secondary d-block">CSV Column Header</span>
                            <span class="fs-sm fw-700">contact_email_addr</span>
                        </div>
                        <span class="material-icons text-secondary">trending_flat</span>
                        <div style="text-align: right;">
                            <span class="fs-xs text-secondary d-block">TimeFlow Property</span>
                            <span class="badge bg-success-glow text-success fs-xs fw-600">Email Address <span class="material-icons fs-xs align-middle">check</span></span>
                        </div>
                    </div>

                    <!-- Mapping Card 3 -->
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-sm bg-input border">
                        <div>
                            <span class="fs-xs text-secondary d-block">CSV Column Header</span>
                            <span class="fs-sm fw-700">personal_kiosk_pin</span>
                        </div>
                        <span class="material-icons text-secondary">trending_flat</span>
                        <div style="text-align: right;">
                            <span class="fs-xs text-secondary d-block">TimeFlow Property</span>
                            <span class="badge bg-secondary-glow text-secondary fs-xs fw-600">Secure PIN (Auto-Seeded)</span>
                        </div>
                    </div>
                </div>

                <!-- Live Status Metrics -->
                <div class="d-flex gap-4 mt-6">
                    <div class="flex-1 p-3 rounded-sm bg-input text-center border">
                        <span class="fs-xs text-secondary d-block">Fuzzy Matches</span>
                        <span class="fs-sm fw-700 text-warning">0 Conflicts</span>
                    </div>
                    <div class="flex-1 p-3 rounded-sm bg-input text-center border">
                        <span class="fs-xs text-secondary d-block">License Check</span>
                        <span class="fs-sm fw-700 text-success">Within Quota</span>
                    </div>
                </div>
            </div>

            <!-- Right Side: Details on importing features -->
            <div class="d-flex flex-column gap-6">
                <div>
                    <h3 class="fs-2xl mb-2">Import, Reconcile, and Deploy in Minutes</h3>
                    <p class="fs-md text-secondary lh-base">
                        Managers can upload roster lists containing thousands of user records. Our onboarding wizard validates data integrity dynamically to keep you within plans parameters.
                    </p>
                </div>

                <div class="d-flex flex-column gap-4">
                    <div class="d-flex gap-3 align-items-start">
                        <span class="material-icons text-primary fs-xl mt-1">auto_awesome</span>
                        <div>
                            <h4 class="fs-md mb-1 fw-600">Smart Headers Mapping</h4>
                            <p class="fs-sm text-secondary">
                                Algorithms automatically match standard columns (e.g. emails, phone formats) to target attributes.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start">
                        <span class="material-icons text-success fs-xl mt-1">difference</span>
                        <div>
                            <h4 class="fs-md mb-1 fw-600">Reconciliation Diff Preview</h4>
                            <p class="fs-sm text-secondary">
                                Displays a side-by-side reconciliation list of Added, Updated, and Unchanged profiles before committing database writes.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start">
                        <span class="material-icons text-warning fs-xl mt-1">vpn_key</span>
                        <div>
                            <h4 class="fs-md mb-1 fw-600">Auto PIN Generator Fallback</h4>
                            <p class="fs-sm text-secondary">
                                If users don't have PIN numbers in the spreadsheet, the seeder creates unique 4-character numbers securely.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Use Cases & SMB Business Benefits Section -->
    <section class="d-flex flex-column gap-12 mt-12 mb-12 reveal">
        <div class="text-center">
            <h2 class="fs-3xl">Built for Every <span class="text-gradient">Check-In Scenario</span></h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                TimeFlow adapts to your organization's workflow, whether tracking shift hours, class attendance, or event promoter activities.
            </p>
        </div>

        <div class="grid-cols-4 gap-6">
            <!-- Use Case 1: Shift Workers -->
            <div class="glass-panel p-6 d-flex flex-column justify-content-between hover-scale" style="background: linear-gradient(180deg, rgba(255,255,255,0.01) 0%, rgba(16,185,129,0.02) 100%);">
                <div>
                    <div class="text-success d-inline-flex align-items-center justify-content-center mb-4 rounded-sm icon-40 bg-success-glow">
                        <span class="material-icons">engineering</span>
                    </div>
                    <h4 class="fs-lg mb-2 fw-600">Shift Workers & Employees</h4>
                    <p class="fs-sm text-secondary lh-base">
                        Eliminate buddy punching using a secure PIN kiosk. Configure custom overtime multipliers and set automatic checkout limits to prevent wage leakage.
                    </p>
                </div>
                <div class="fs-xs text-success fw-600 mt-4 d-flex align-items-center gap-1">
                    <span class="material-icons fs-sm">trending_up</span> Improves payroll accuracy by 18%
                </div>
            </div>

            <!-- Use Case 2: Students & Classrooms -->
            <div class="glass-panel p-6 d-flex flex-column justify-content-between hover-scale" style="background: linear-gradient(180deg, rgba(255,255,255,0.01) 0%, rgba(99,102,241,0.02) 100%);">
                <div>
                    <div class="text-primary d-inline-flex align-items-center justify-content-center mb-4 rounded-sm icon-40 bg-primary-glow">
                        <span class="material-icons">school</span>
                    </div>
                    <h4 class="fs-lg mb-2 fw-600">Students & Classrooms</h4>
                    <p class="fs-sm text-secondary lh-base">
                        Track classroom hours for bootcamps or seminars. Allow students to select their name from an open kiosk roster list for friction-free check-ins.
                    </p>
                </div>
                <div class="fs-xs text-primary fw-600 mt-4 d-flex align-items-center gap-1">
                    <span class="material-icons fs-sm">trending_up</span> Saves 15 mins of class time daily
                </div>
            </div>

            <!-- Use Case 3: Contractors & Agencies -->
            <div class="glass-panel p-6 d-flex flex-column justify-content-between hover-scale" style="background: linear-gradient(180deg, rgba(255,255,255,0.01) 0%, rgba(139,92,246,0.02) 100%);">
                <div>
                    <div class="text-indigo d-inline-flex align-items-center justify-content-center mb-4 rounded-sm icon-40" style="background: rgba(139,92,246,0.1); color: var(--text-accent-strong);">
                        <span class="material-icons">assignment_ind</span>
                    </div>
                    <h4 class="fs-lg mb-2 fw-600">Contractors & Agencies</h4>
                    <p class="fs-sm text-secondary lh-base">
                        Track promoter activities and billable subcontractor timesheets across multiple client tenants. Export logs directly as formatted CSV files.
                    </p>
                </div>
                <div class="fs-xs fw-600 mt-4 d-flex align-items-center gap-1" style="color: var(--text-accent);">
                    <span class="material-icons fs-sm">trending_up</span> Streamlines client invoicing cycles
                </div>
            </div>

            <!-- Use Case 4: Attendees & Event Promoters -->
            <div class="glass-panel p-6 d-flex flex-column justify-content-between hover-scale" style="background: linear-gradient(180deg, rgba(255,255,255,0.01) 0%, rgba(245,158,11,0.02) 100%);">
                <div>
                    <div class="text-warning d-inline-flex align-items-center justify-content-center mb-4 rounded-sm icon-40 bg-warning-glow">
                        <span class="material-icons">campaign</span>
                    </div>
                    <h4 class="fs-lg mb-2 fw-600">Event Staff & Promoters</h4>
                    <p class="fs-sm text-secondary lh-base">
                        Monitor live attendance and event staff schedules from a centralized mobile dashboard, allowing managers to handle checkouts from anywhere.
                    </p>
                </div>
                <div class="fs-xs text-warning fw-600 mt-4 d-flex align-items-center gap-1">
                    <span class="material-icons fs-sm">trending_up</span> Cuts administrative audit time by 60%
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Sales Tools Section -->
    <section class="d-flex flex-column gap-12 mt-12 mb-12 reveal">
        <div class="text-center">
            <h2 class="fs-3xl">Analyze Your <span class="text-gradient">Operational Savings</span></h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                See how automated kiosk tracking and policy controls eliminate administrative waste.
            </p>
        </div>

        <div class="grid-cols-2 gap-8 align-items-stretch">
            <!-- Column 1: ROI Calculator Widget -->
            <div class="glass-panel p-8 d-flex flex-column gap-6 justify-content-between">
                <div>
                    <h3 class="fs-xl mb-4 d-flex align-items-center gap-2">
                        <span class="material-icons text-primary">calculate</span> ROI Savings Calculator
                    </h3>
                    <p class="fs-md text-secondary mb-6">
                        Adjust parameters to calculate estimated annual savings by moving away from manual logs.
                    </p>

                    <div class="d-flex flex-column gap-5">
                        <!-- Parameter: Active Tracked Users Count -->
                        <div>
                            <div class="d-flex justify-content-between mb-2">
                                <label class="fs-sm fw-600 text-indigo-200">Active Tracked Users</label>
                                <span class="fs-sm fw-700" id="roi-emp-label">45 Users</span>
                            </div>
                            <input type="range" min="5" max="250" value="45" class="w-100" id="roi-emp-input" style="accent-color: var(--primary);">
                        </div>

                        <!-- Parameter: Hourly Rate -->
                        <div>
                            <div class="d-flex justify-content-between mb-2">
                                <label class="fs-sm fw-600 text-indigo-200">Average Hourly Rate</label>
                                <span class="fs-sm fw-700" id="roi-wage-label">$25 / hr</span>
                            </div>
                            <input type="range" min="12" max="100" value="25" class="w-100" id="roi-wage-input" style="accent-color: var(--primary);">
                        </div>

                        <!-- Parameter: Time Saved -->
                        <div>
                            <div class="d-flex justify-content-between mb-2">
                                <label class="fs-sm fw-600 text-indigo-200">Weekly Time Theft/Errors (hrs / user)</label>
                                <span class="fs-sm fw-700" id="roi-time-label">2.5 hrs</span>
                            </div>
                            <input type="range" min="0.5" max="10" step="0.5" value="2.5" class="w-100" id="roi-time-input" style="accent-color: var(--primary);">
                        </div>
                    </div>
                </div>

                <!-- ROI Results Display -->
                <div class="bg-input p-5 rounded-md mt-6 d-flex flex-column gap-4 border">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-md text-secondary">Annual Hours Recovered:</span>
                        <span class="fs-xl fw-700 text-success" id="roi-hours-output">5,850 hrs</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-md text-secondary">Estimated Annual Savings:</span>
                        <span class="fs-2xl fw-800" id="roi-savings-output">$146,250</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-t pt-3">
                        <span class="fs-sm text-secondary">TimeFlow Plan Cost:</span>
                        <span class="fs-sm fw-600 text-indigo-200" id="roi-cost-output">$348 / year</span>
                    </div>
                </div>
            </div>

            <!-- Column 2: Live Manager Dashboard Widget Preview -->
            <div class="glass-panel p-8 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fs-xl m-0 d-flex align-items-center gap-2">
                            <span class="material-icons text-success">analytics</span> Live Dashboard Widget
                        </h3>
                        <span class="badge bg-success-glow text-success fs-xs fw-700 d-flex align-items-center gap-1 animate-pulse">
                            <span class="dot-indicator"></span> ACTIVE PREVIEW
                        </span>
                    </div>
                    <p class="fs-md text-secondary mb-6">
                        Interactive manager metrics preview. Observe mock live clock-in events updates.
                    </p>

                    <!-- Mock Dashboard Frame -->
                    <div class="p-5 rounded-md bg-input border">
                        <!-- Stats Grid -->
                        <div class="d-flex gap-4 mb-4">
                            <div class="flex-1 p-3 bg-input rounded-sm border">
                                <span class="fs-xs text-secondary text-uppercase tracking-wider">Checked In</span>
                                <div class="fs-xl fw-700 mt-1" id="mock-active-count">12 / 45</div>
                            </div>
                            <div class="flex-1 p-3 bg-input rounded-sm border">
                                <span class="fs-xs text-secondary text-uppercase tracking-wider">Overtime Alerts</span>
                                <div class="fs-xl fw-700 text-danger mt-1">1 Pending</div>
                            </div>
                        </div>

                        <!-- Active Roster Activity Feed -->
                        <div class="d-flex flex-column gap-3" id="mock-activity-feed">
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-sm" style="background: var(--bg-hover); border-left: 3px solid var(--primary);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar bg-primary text-white rounded-full d-flex align-items-center justify-content-center fw-600" style="width: 32px; height: 32px; font-size: 0.75rem;">JS</div>
                                    <div>
                                        <div class="fs-sm fw-600">John Smith</div>
                                        <div class="fs-xs text-secondary">General Shift</div>
                                    </div>
                                </div>
                                <span class="fs-xs text-muted" id="mock-timer-1">04:12:15</span>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-sm" style="background: var(--bg-hover); border-left: 3px solid var(--success);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar bg-success text-white rounded-full d-flex align-items-center justify-content-center fw-600" style="width: 32px; height: 32px; font-size: 0.75rem;">AD</div>
                                    <div>
                                        <div class="fs-sm fw-600">Alice Davis</div>
                                        <div class="fs-xs text-secondary">Creative Shift</div>
                                    </div>
                                </div>
                                <span class="fs-xs text-muted" id="mock-timer-2">01:45:03</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Simulation Speed Control -->
                <div class="d-flex justify-content-between align-items-center mt-6">
                    <span class="fs-sm text-secondary">Simulator Actions:</span>
                    <button class="btn btn-secondary fs-sm" id="btn-mock-clockin" style="padding: 0.35rem 0.85rem;">
                        <span class="material-icons fs-sm">add</span> Clock-In Guest
                    </button>
                </div>
            </div>
        </div>

        <!-- Custom Demo Booking Lead Form -->
        <div class="glass-panel p-8 mt-6" style="background: radial-gradient(circle at top right, rgba(99,102,241,0.05), transparent 60%);">
            <div class="d-flex flex-column md-flex-row justify-content-between align-items-center gap-6">
                <div>
                    <h3 class="fs-2xl mb-2">Request a Customized Demonstration</h3>
                    <p class="fs-md text-secondary m-0">
                        Consult with our engineering team to construct specific integrations for your organization.
                    </p>
                </div>
                <div class="d-flex gap-3 w-100 max-w-400">
                    <input type="email" placeholder="enter your email address" class="form-control flex-1" id="sales-lead-email">
