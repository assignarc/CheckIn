{% extends 'home/layout.html.twig' %}

{% block title %}CenterTime - Multi-Tenant Time Tracking & Check-In Platform{% endblock %}
{% block stylesheets %}
    <style>
        /* Custom scroll-reveal styles for premium homepage layout */
        .reveal-hero {
            opacity: 0;
            transform: scale(0.96) translateY(20px);
            transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
            will-change: opacity, transform;
        }
        .reveal-hero.active {
            opacity: 1;
            transform: scale(1) translateY(0);
        }

        .reveal-left {
            opacity: 0;
            transform: translateX(-40px);
            transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
            will-change: opacity, transform;
        }
        .reveal-left.active {
            opacity: 1;
            transform: translateX(0);
        }

        .reveal-right {
            opacity: 0;
            transform: translateX(40px);
            transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
            will-change: opacity, transform;
        }
        .reveal-right.active {
            opacity: 1;
            transform: translateX(0);
        }

        .reveal-scale {
            opacity: 0;
            transform: scale(0.92);
            transition: opacity 1s cubic-bezier(0.34, 1.56, 0.64, 1), transform 1s cubic-bezier(0.34, 1.56, 0.64, 1);
            will-change: opacity, transform;
        }
        .reveal-scale.active {
            opacity: 1;
            transform: scale(1);
        }

        /* Disable scroll reveal on mobile/tablet viewports to prevent rendering and overflow issues */
        @media (max-width: 768px) {
            .reveal-hero, .reveal-left, .reveal-right, .reveal-scale {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }
        }

        .grid-cols-5 {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1.5rem;
        }
        @media (max-width: 1200px) {
            .grid-cols-5 {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        @media (max-width: 768px) {
            .grid-cols-5 {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .grid-cols-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
        }
        @media (max-width: 1024px) {
            .grid-cols-4 {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 600px) {
            .grid-cols-4 {
                grid-template-columns: 1fr;
            }
        }

        /* Interactive Audit Event Console styles */
        .audit-event-tab {
            background: transparent;
            border: 1px solid transparent;
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .audit-event-tab:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.08);
        }
        
        /* Interactive Kiosk Mode switcher tabs */
        .kiosk-mode-tab {
            background: transparent;
            border: 1px solid transparent;
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            padding: 0.5rem 1rem;
            font-family: var(--font-sans);
            font-weight: 500;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all var(--transition-fast);
            cursor: pointer;
            outline: none;
        }
        .kiosk-mode-tab:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }
        .kiosk-mode-tab.active {
            background: var(--primary-glow) !important;
            border-color: rgba(99, 102, 241, 0.3) !important;
            color: var(--primary) !important;
        }
        .kiosk-mode-tab.active .material-icons {
            color: var(--primary) !important;
        }
        .audit-event-tab.active {
            background: rgba(99, 102, 241, 0.15) !important;
            border-color: rgba(99, 102, 241, 0.3) !important;
        }
        .audit-event-tab.active .material-icons {
            transform: translateX(4px);
            transition: transform 0.2s ease;
        }
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
        @media (min-width: 576px) {
            .sm-rotate-0 {
                transform: rotate(0deg) !important;
            }
        }

        /* Onboarding Slide Animation Styles */
        .onboarding-slide {
            display: none;
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
        }
        .onboarding-slide.active {
            display: block;
            opacity: 1;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #888888 !important;
            opacity: 0.55 !important;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-block;
            margin: 0 4px;
            border: 1px solid rgba(0, 0, 0, 0.12);
        }
        .dot:hover {
            background: var(--primary) !important;
            opacity: 0.95 !important;
            transform: scale(1.2);
        }
        .dot.active {
            background: var(--primary) !important;
            opacity: 1 !important;
            box-shadow: 0 0 10px var(--primary);
            width: 28px;
            border-radius: 6px;
        }

        @keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.1); opacity: 0.7; }
            100% { transform: scale(1); opacity: 1; }
        }

        /* Demo simulation visual elements */
        .demo-sim-screen {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
            position: relative;
        }
        .sim-browser-bar {
            background: #1e293b;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid #334155;
        }
        .sim-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }
        .sim-dot-red { background: #ef4444; }
        .sim-dot-yellow { background: #f59e0b; }
        .sim-dot-green { background: #10b981; }
        .sim-address-bar {
            background: #0f172a;
            border-radius: 6px;
            color: #94a3b8;
            font-size: 0.75rem;
            padding: 4px 12px;
            flex-grow: 1;
            margin-left: 12px;
            font-family: monospace;
            border: 1px solid #334155;
        }

        .mock-user-row {
            border: 1px solid #334155;
            background: #1e293b;
            border-radius: 8px;
            padding: 10px 16px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .mock-user-row.active-click {
            background: var(--primary-glow) !important;
            border-color: var(--primary) !important;
            transform: scale(0.98);
        }
        .mock-cursor {
            position: absolute;
            width: 20px;
            height: 20px;
            pointer-events: none;
            z-index: 100;
            transition: all 1.2s cubic-bezier(0.25, 1, 0.5, 1);
            opacity: 0;
        }
        .laser-line {
            position: absolute;
            left: 0;
            width: 100%;
            height: 3px;
            background: #ef4444;
            box-shadow: 0 0 8px #ef4444;
            animation: laser-sweep 2s ease-in-out infinite;
            z-index: 10;
        }
        .laser-line.scan-success {
            background: #10b981;
            box-shadow: 0 0 8px #10b981;
        }
        .mock-badge {
            transition: all 1s cubic-bezier(0.25, 1, 0.5, 1);
            transform: translateY(120px);
            opacity: 0;
        }
        .mock-badge.scanning {
            transform: translateY(0);
            opacity: 1;
        }
        .mock-keypad-btn.active-key {
            background: var(--primary) !important;
            color: #white !important;
            box-shadow: 0 0 12px var(--primary) !important;
            transform: scale(0.95);
        }

        /* Compact Keypad overrides for homepage preview card */
        .glass-panel .pin-grid {
            gap: 0.4rem !important;
            max-width: 200px !important;
        }
        .glass-panel .pin-btn {
            width: 42px !important;
            height: 42px !important;
            font-size: 1.05rem !important;
        }
        .glass-panel .pin-dot {
            width: 12px !important;
            height: 12px !important;
            font-size: 1.05rem !important;
        }

        @keyframes laser-sweep {
            0% { top: 10%; }
            50% { top: 90%; }
            100% { top: 10%; }
        }
    </style>
{% endblock %}

{% block content %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} mb-6">
                <span class="material-icons">
                    {% if type == 'danger' %}error{% else %}check_circle{% endif %}
                </span>
                <span>{{ message|raw }}</span>
            </div>
        {% endfor %}
    {% endfor %}
    
    <!-- Hero Section -->
    <section class="hero-grid align-items-center gap-16">
        <div>
            <div class="d-inline-flex align-items-center gap-2 mb-6 p-0 rounded-full" style="padding: .35rem 1rem; background: var(--primary-glow); border: 1px solid rgba(99,102,241,0.2)">
                <span class="material-icons fs-md text-primary">bolt</span>
                <span class="fs-sm fw-600 text-uppercase text-indigo-200 tracking-wide">Multi-Tenant Time Kiosk</span>
            </div>
            <h1 class="fs-5xl mb-6" style="line-height: 1.15; letter-spacing: -0.03em">
                Next-Gen <span class="text-gradient">Time Tracking</span><br>For Modern Teams.
            </h1>
            <p class="fs-lg text-secondary mb-10 max-w-600" style="line-height: 1.6">
                Streamline user check-ins with secure PIN entries, custom data fields, customizable time windows, and robust manager-level reporting. Built to scale with multi-tenant logical separation.
            </p>
            <div class="d-flex flex-wrap gap-4">
                {% if new_signups_enabled %}
                    <a href="{{ path('app_signup') }}" class="btn btn-primary fs-lg" >
                        Create your organization <span class="material-icons">arrow_forward</span>
                    </a>
                {% else %}
                    <button class="btn btn-primary fs-lg" disabled style="opacity: 0.6; cursor: not-allowed;">
                        Registration Closed
                    </button>
                {% endif %}
                <a href="{{ path('app_demo') }}" class="btn btn-secondary fs-lg">
                    Request Live Demo
                </a>
            </div>
        </div>
        
        <div class="glass-panel d-flex flex-column gap-4 p-6 position-relative" style="min-height: 440px; overflow: hidden;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="fs-xl d-flex align-items-center gap-2 m-0">
                    <span class="material-icons text-primary">tablet_mac</span> Kiosk Mode Demo
                </h3>
            </div>

            <!-- Mode Switcher Tabs -->
            <div class="d-flex border-b pb-1" style="gap: 0.5rem;">
                <button type="button" class="kiosk-mode-tab active" onclick="setKioskMode('basic', true)">
                    <span class="material-icons fs-md">search</span> Basic Search
                </button>
                <button type="button" class="kiosk-mode-tab" onclick="setKioskMode('pin', true)">
                    <span class="material-icons fs-md">dialpad</span> Secure PIN
                </button>
                <button type="button" class="kiosk-mode-tab" onclick="setKioskMode('barcode', true)">
                    <span class="material-icons fs-md">qr_code_scanner</span> Barcode / QR
                </button>
            </div>

            <div class="position-relative flex-grow-1" style="zoom: 0.75;">
                <!-- Mock Mouse Cursor for Basic mode -->
                <span class="material-icons mock-cursor" id="kiosk-mock-cursor" style="color: #ffffff; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">near_me</span>

                <!-- 1. BASIC LIST MODE CONTAINER -->
                <div class="kiosk-frame" id="kiosk-frame-basic">
                    <div class="fs-xs text-uppercase text-muted mb-3 text-center">Acme Corp Open Kiosk</div>
                    <div class="d-flex flex-column gap-3" id="kiosk-basic-list">
                        <!-- Search Box Container -->
                        <div id="kiosk-basic-search-container" class="position-relative">
                            <input type="text" id="kiosk-basic-search" class="form-control w-100 bg-input border rounded-sm p-3 fs-sm" placeholder="Search your name..." readonly style="color: var(--text-primary); pointer-events: none;">
                            <span class="material-icons position-absolute text-muted" style="right: 12px; top: 12px;">search</span>
                        </div>

                        <!-- User Row 2 (Target) - Hidden initially, shown after typing -->
                        <div class="mock-user-row d-flex justify-content-between align-items-center p-3 rounded-sm bg-input border" id="mock-row-2" style="display: none !important;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar bg-success text-white rounded-full d-flex align-items-center justify-content-center fw-600" style="width: 36px; height: 36px;">BJ</div>
                                <div class="fw-700 fs-sm">Bob Johnson</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success fs-xs py-1 px-2" id="mock-checkin-btn" style="pointer-events: none;">Check In</button>
                                <button type="button" class="btn btn-secondary fs-xs py-1 px-2" id="mock-checkout-btn" disabled style="opacity: 0.5;">Check Out</button>
                            </div>
                        </div>

                        <!-- Check-In Success State -->
                        <div id="mock-basic-success" style="display: none;" class="p-6 rounded-md bg-success-glow text-center d-flex flex-column align-items-center justify-content-center gap-3 border" style="border-color: rgba(16,185,129,0.3) !important;">
                            <span class="material-icons text-success fs-3xl" style="animation: scale-up 0.5s ease">check_circle</span>
                            <div>
                                <div class="fs-lg fw-800 text-success">Verified: Bob Johnson</div>
                                <div class="fs-xs text-secondary mt-1">Checked In Successfully • 10:45 AM</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. PIN MODE CONTAINER -->
                <div class="kiosk-frame" id="kiosk-frame-pin" style="display: none;">
                    <div class="fs-xs text-uppercase text-muted mb-2 text-center">Acme Corp Secure Kiosk</div>
                    
                    <div id="kiosk-pin-keypad-view">
                        <div class="fs-xl fw-700 mb-3 text-center">Enter Security PIN</div>
                        <div class="d-flex justify-content-center gap-3 mb-4" id="kiosk-pin-dots">
                            <div class="pin-dot" id="pin-dot-1"></div>
                            <div class="pin-dot" id="pin-dot-2"></div>
                            <div class="pin-dot" id="pin-dot-3"></div>
                            <div class="pin-dot" id="pin-dot-4"></div>
                        </div>
                        <div class="pin-grid">
                            <div class="pin-btn pin-btn-special mock-keypad-btn" id="key-C">C</div>
                            <div class="pin-btn pin-btn-special mock-keypad-btn" id="key-B">B</div>
                            <div class="pin-btn pin-btn-special mock-keypad-btn" id="key-A">A</div>
                            <div class="pin-btn mock-keypad-btn" id="key-1">1</div>
                            <div class="pin-btn mock-keypad-btn" id="key-2">2</div>
                            <div class="pin-btn mock-keypad-btn" id="key-3">3</div>
                            <div class="pin-btn mock-keypad-btn" id="key-4">4</div>
                            <div class="pin-btn mock-keypad-btn" id="key-5">5</div>
                            <div class="pin-btn mock-keypad-btn" id="key-6">6</div>
                            <div class="pin-btn mock-keypad-btn" id="key-7">7</div>
                            <div class="pin-btn mock-keypad-btn" id="key-8">8</div>
                            <div class="pin-btn mock-keypad-btn" id="key-9">9</div>
                            <div class="pin-btn pin-btn-clear" style="font-size: 0.9rem;">Clear</div>
                            <div class="pin-btn mock-keypad-btn" id="key-0">0</div>
                            <div class="pin-btn"><span class="material-icons">backspace</span></div>
                        </div>
                    </div>

                    <!-- PIN Success Screen -->
                    <div id="kiosk-pin-success-view" style="display: none;" class="p-6 rounded-md bg-success-glow text-center d-flex flex-column align-items-center justify-content-center gap-3 border" style="border-color: rgba(16,185,129,0.3) !important;">
                        <span class="material-icons text-success fs-3xl" style="animation: scale-up 0.5s ease">check_circle</span>
                        <div>
                            <div class="fs-lg fw-800 text-success">Verified: Sarah Miller</div>
                            <div class="fs-xs text-secondary mt-1">Checked In Successfully • 10:45 AM</div>
                        </div>
                    </div>
                </div>

                <!-- 3. BARCODE MODE CONTAINER -->
                <div class="kiosk-frame" id="kiosk-frame-barcode" style="display: none;">
                    <div class="fs-xs text-uppercase text-muted mb-3 text-center">Contactless Badge Scanner</div>
                    
                    <!-- Scanner Viewport Mockup -->
                    <div class="position-relative rounded-md border bg-black d-flex align-items-center justify-content-center" style="height: 220px; overflow: hidden; background: #0c0f1d;">
                        <div class="laser-line" id="kiosk-laser-line"></div>
                        
                        <!-- Overlay targeting bracket square -->
                        <div style="position: absolute; width: 120px; height: 120px; border: 2px dashed rgba(255,255,255,0.3); z-index: 5; border-radius: var(--radius-sm);"></div>

                        <!-- Scannable Badge Graphic -->
                        <div class="mock-badge bg-card border p-3 rounded-md d-flex align-items-center gap-3" id="kiosk-mock-badge" style="width: 180px; box-shadow: var(--shadow-lg); z-index: 8;">
                            <div class="flex-grow-1">
                                <div class="fw-700" style="font-size: 0.7rem; color: var(--text-main);">John Doe</div>
                                <div class="text-secondary" style="font-size: 0.55rem;">PIN: C831</div>
                            </div>
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=50x50&data=C831" style="width: 32px; height: 32px;" alt="QR">
                        </div>

                        <!-- Scan Success message toast overlay -->
                        <div id="kiosk-barcode-success" style="display: none; position: absolute; bottom: 10px; left: 10px; right: 10px; z-index: 12;" class="p-2 rounded-sm bg-success text-white text-center fs-xs fw-700">
                            ✓ Badge Verified: John Doe Checked In!
                        </div>
                    </div>
                </div>
            </div>
            <p class="fs-xs text-center text-secondary m-0">
                Switch modes to see standard roster listings, secure keyboard locks, or fast camera badge scanners.
            </p>
        </div>
    </section>

    <!-- Key Platform Benefits Section -->
    <section class="d-flex flex-column gap-12 reveal-scale">
        <div class="text-center">
            <h2 class="fs-3xl">Engineered for <span class="text-gradient">Precision</span> and Control</h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                CenterTime provides managers with high-fidelity control over shifts logs, auditing, and compliance constraints.
            </p>
        </div>

        <div class="grid-cols-3 gap-6 mb-6">
            <div class="glass-panel p-6">
                <span class="material-icons text-primary mb-4 fs-3xl">gavel</span>
                <h4 class="fs-lg mb-2">Time Window Enforcement</h4>
                <p class="fs-md text-secondary lh-base">
                    Set specific windows for clocking in and out (including overnight shifts support) and automatically flag violations in manager dashboards.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-success mb-4 fs-3xl">cloud_sync</span>
                <h4 class="fs-lg mb-2">Onboarding & Fuzzy Matching</h4>
                <p class="fs-md text-secondary lh-base">
                    Upload existing rosters via CSV. Map custom columns and run fuzzy matching checks to prevent duplicates while merging updates.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-warning mb-4 fs-3xl">security</span>
                <h4 class="fs-lg mb-2">Anti-Brute Force Lockout</h4>
                <p class="fs-md text-secondary lh-base">
                    Protects the workplace kiosk by automatically locking user accounts after 3 incorrect PIN attempts. Managers can clear blocks in a click.
                </p>
            </div>
        </div>
        <div class="grid-cols-3 gap-6">
            <div class="glass-panel p-6">
                <span class="material-icons text-info mb-4 fs-3xl">category</span>
                <h4 class="fs-lg mb-2">Custom Category Limits</h4>
                <p class="fs-md text-secondary lh-base">
                    Override organization-wide limits with custom max session durations per category, giving you granular control.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-indigo mb-4 fs-3xl">payments</span>
                <h4 class="fs-lg mb-2">Advanced Overtime Rules</h4>
                <p class="fs-md text-secondary lh-base">
                    Configure overtime multipliers and grace periods to accurately track and calculate shift overages.
                </p>
            </div>
            <div class="glass-panel p-6">
                <span class="material-icons text-danger mb-4 fs-3xl">verified_user</span>
                <h4 class="fs-lg mb-2">Math Captcha Security</h4>
                <p class="fs-md text-secondary lh-base">
                    Built-in mathematical captchas on sensitive operations to prevent automated abuse and enhance platform security.
                </p>
            </div>
        </div>
    </section>

    <!-- Real-Time Event & Audit Stream Catalog -->
    <section class="d-flex flex-column gap-12 mt-16 mb-12 reveal-scale">
        <div class="text-center">
            <h2 class="fs-3xl">Traceability & Audit: <span class="text-gradient">10 Core System Events</span></h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                CenterTime logs every critical business mutation to ensure security, automated compliance, and absolute accountability. Explore our core audit logs below.
            </p>
        </div>

        <div class="grid-cols-5 gap-6">
            <!-- Event 1 -->
            <div class="glass-panel p-6 d-flex flex-column justify-content-between" style="border-top: 4px solid var(--primary); min-height: 250px;">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="material-icons text-primary fs-xl" style="font-size: 1.5rem;">login</span>
                        <span class="fs-xs fw-600 text-muted">Attendance</span>
                    </div>
                    <h4 class="fs-md fw-700 mb-2">User Check-In / Out</h4>
                    <p class="fs-xs text-secondary lh-base mb-3">
                        Fired when an employee clocks in or out at the kiosk using their PIN or barcode.
                    </p>
                </div>
                <div class="border-t pt-3">
                    <span class="fs-xs text-success fw-600">Why it matters:</span>
                    <p class="m-0 fs-xs text-secondary mt-1">Crucial for payroll accuracy, tracking labor hours, and calculating timesheets.</p>
                </div>
            </div>

            <!-- Event 2 -->
            <div class="glass-panel p-6 d-flex flex-column justify-content-between" style="border-top: 4px solid #10b981; min-height: 250px;">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="material-icons text-success fs-xl" style="font-size: 1.5rem;">cloud_upload</span>
                        <span class="fs-xs fw-600 text-muted">Onboarding</span>
                    </div>
                    <h4 class="fs-md fw-700 mb-2">Bulk User Import</h4>
                    <p class="fs-xs text-secondary lh-base mb-3">
                        Emitted when a manager imports multiple employee records using the CSV Wizard.
                    </p>
                </div>
                <div class="border-t pt-3">
