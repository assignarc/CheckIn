{% extends 'home/layout.html.twig' %}

{% block title %}CenterTime - Multi-Tenant Time Tracking & Check-In Platform{% endblock %}
{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block content %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} mb-6">
                <span class="material-icons">
                    {% if type == 'danger' %}error{% else %}check_circle{% endif %}
                </span>
                <span>{{ message|raw }}</span>
            </div>
        {% endfor %}
    {% endfor %}
    
    <!-- Hero Section -->
    <section class="hero-grid align-items-center gap-16">
        <div>
            <div class="d-inline-flex align-items-center gap-2 mb-6 p-0 rounded-full" style="padding: .35rem 1rem; background: var(--primary-glow); border: 1px solid rgba(99,102,241,0.2)">
                <span class="material-icons fs-md text-primary">bolt</span>
                <span class="fs-sm fw-600 text-uppercase text-indigo-200 tracking-wide">Automated Time Kiosk Platform</span>
            </div>
            <h1 class="fs-5xl mb-6" style="line-height: 1.15; letter-spacing: -0.03em">
                Next-Gen <span class="text-gradient">Time Tracking</span> For Modern Teams.
            </h1>
            <p class="fs-lg text-secondary mb-10" style="line-height: 1.6">
                Streamline user check-ins with secure PIN entries, contactless barcode scanning, customizable time windows, and robust manager-level reporting built for maximum accuracy and ease of use.
            </p>
            <div class="d-flex flex-wrap gap-4">
                {% if new_signups_enabled %}
                    <a href="{{ path('app_signup') }}" class="btn btn-primary fs-lg" >
                        Create your organization <span class="material-icons">arrow_forward</span>
                    </a>
                {% else %}
                    <button class="btn btn-primary fs-lg" disabled style="opacity: 0.6; cursor: not-allowed;">
                        Registration Closed
                    </button>
                {% endif %}
                <a href="{{ path('app_demo') }}" class="btn btn-secondary fs-lg">
                    Request Live Demo
                </a>
            </div>
        </div>
        
        <div class="glass-panel d-flex flex-column gap-4 p-6 position-relative" style="min-height: 440px; overflow: hidden;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="fs-xl d-flex align-items-center gap-2 m-0">
                    <span class="material-icons text-primary">tablet_mac</span> Kiosk Mode Demo
                </h3>
            </div>

            <!-- Mode Switcher Tabs -->
            <div class="d-flex border-b pb-1" style="gap: 0.5rem;">
                <button type="button" class="kiosk-mode-tab active" onclick="setKioskMode('basic', true)">
                    <span class="material-icons fs-md">search</span> Basic Search
                </button>
                <button type="button" class="kiosk-mode-tab" onclick="setKioskMode('pin', true)">
                    <span class="material-icons fs-md">dialpad</span> Secure PIN
                </button>
                <button type="button" class="kiosk-mode-tab" onclick="setKioskMode('barcode', true)">
                    <span class="material-icons fs-md">qr_code_scanner</span> Barcode / QR
                </button>
            </div>

            <div class="position-relative flex-grow-1 w-100" style="overflow: hidden;">
                <!-- Mock Mouse Cursor for Basic mode -->
                <span class="material-icons mock-cursor" id="kiosk-mock-cursor" style="color: #ffffff; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">near_me</span>

                <!-- 1. BASIC LIST MODE CONTAINER -->
                <div class="kiosk-frame" id="kiosk-frame-basic">
                    <div class="fs-xs text-uppercase text-muted mb-3 text-center">Acme Corp Open Kiosk</div>
                    <div class="d-flex flex-column gap-3" id="kiosk-basic-list">
                        <!-- Search Box Container -->
                        <div id="kiosk-basic-search-container" class="position-relative">
                            <input type="text" id="kiosk-basic-search" class="form-control w-100 bg-input border rounded-sm p-3 fs-sm" placeholder="Search your name..." readonly style="color: var(--text-primary); pointer-events: none;">
                            <span class="material-icons position-absolute text-muted" style="right: 12px; top: 12px;">search</span>
                        </div>

                        <!-- User Row 2 (Target) - Hidden initially, shown after typing -->
                        <div class="mock-user-row d-flex justify-content-between align-items-center p-3 rounded-sm bg-input border" id="mock-row-2" style="display: none !important;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar bg-success text-white rounded-full d-flex align-items-center justify-content-center fw-600" style="width: 36px; height: 36px;">BJ</div>
                                <div class="fw-700 fs-sm">Bob Johnson</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success fs-xs py-1 px-2" id="mock-checkin-btn" style="pointer-events: none;">Check In</button>
                                <button type="button" class="btn btn-secondary fs-xs py-1 px-2" id="mock-checkout-btn" disabled style="opacity: 0.5;">Check Out</button>
                            </div>
                        </div>

                        <!-- Check-In Success State -->
                        <div id="mock-basic-success" style="display: none;" class="p-6 rounded-md bg-success-glow text-center d-flex flex-column align-items-center justify-content-center gap-3 border" style="border-color: rgba(16,185,129,0.3) !important;">
                            <span class="material-icons text-success fs-3xl" style="animation: scale-up 0.5s ease">check_circle</span>
                            <div>
                                <div class="fs-lg fw-800 text-success">Verified: Bob Johnson</div>
                                <div class="fs-xs text-secondary mt-1">Checked In Successfully • 10:45 AM</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. PIN MODE CONTAINER -->
                <div class="kiosk-frame" id="kiosk-frame-pin" style="display: none;">
                    <div class="fs-xs text-uppercase text-muted mb-2 text-center">Acme Corp Secure Kiosk</div>
                    
                    <div id="kiosk-pin-keypad-view">
                        <div class="fs-xl fw-700 mb-3 text-center">Enter Security PIN</div>
                        <div class="d-flex justify-content-center gap-3 mb-4" id="kiosk-pin-dots">
                            <div class="pin-dot" id="pin-dot-1"></div>
                            <div class="pin-dot" id="pin-dot-2"></div>
                            <div class="pin-dot" id="pin-dot-3"></div>
                            <div class="pin-dot" id="pin-dot-4"></div>
                        </div>
                        <div class="pin-grid">
                            <div class="pin-btn pin-btn-special mock-keypad-btn" id="key-C">C</div>
                            <div class="pin-btn pin-btn-special mock-keypad-btn" id="key-B">B</div>
                            <div class="pin-btn pin-btn-special mock-keypad-btn" id="key-A">A</div>
                            <div class="pin-btn mock-keypad-btn" id="key-1">1</div>
                            <div class="pin-btn mock-keypad-btn" id="key-2">2</div>
                            <div class="pin-btn mock-keypad-btn" id="key-3">3</div>
                            <div class="pin-btn mock-keypad-btn" id="key-4">4</div>
                            <div class="pin-btn mock-keypad-btn" id="key-5">5</div>
                            <div class="pin-btn mock-keypad-btn" id="key-6">6</div>
                            <div class="pin-btn mock-keypad-btn" id="key-7">7</div>
                            <div class="pin-btn mock-keypad-btn" id="key-8">8</div>
                            <div class="pin-btn mock-keypad-btn" id="key-9">9</div>
                            <div class="pin-btn pin-btn-clear" style="font-size: 0.9rem;">Clear</div>
                            <div class="pin-btn mock-keypad-btn" id="key-0">0</div>
                            <div class="pin-btn"><span class="material-icons">backspace</span></div>
                        </div>
                    </div>

                    <!-- PIN Success Screen -->
                    <div id="kiosk-pin-success-view" style="display: none;" class="p-6 rounded-md bg-success-glow text-center d-flex flex-column align-items-center justify-content-center gap-3 border" style="border-color: rgba(16,185,129,0.3) !important;">
                        <span class="material-icons text-success fs-3xl" style="animation: scale-up 0.5s ease">check_circle</span>
                        <div>
                            <div class="fs-lg fw-800 text-success">Verified: Sarah Miller</div>
                            <div class="fs-xs text-secondary mt-1">Checked In Successfully • 10:45 AM</div>
                        </div>
                    </div>
                </div>

                <!-- 3. BARCODE MODE CONTAINER -->
                <div class="kiosk-frame" id="kiosk-frame-barcode" style="display: none;">
                    <div class="fs-xs text-uppercase text-muted mb-3 text-center">Contactless Badge Scanner</div>
                    
                    <!-- Scanner Viewport Mockup -->
                    <div class="position-relative rounded-md border bg-black d-flex align-items-center justify-content-center" style="height: 220px; overflow: hidden; background: #0c0f1d;">
                        <div class="laser-line" id="kiosk-laser-line"></div>
                        
                        <!-- Overlay targeting bracket square -->
                        <div style="position: absolute; width: 120px; height: 120px; border: 2px dashed rgba(255,255,255,0.3); z-index: 5; border-radius: var(--radius-sm);"></div>

                        <!-- Scannable Badge Graphic -->
                        <div class="mock-badge bg-card border p-3 rounded-md d-flex align-items-center gap-3" id="kiosk-mock-badge" style="width: 180px; box-shadow: var(--shadow-lg); z-index: 8;">
                            <div class="flex-grow-1">
                                <div class="fw-700" style="font-size: 0.7rem; color: var(--text-main);">John Doe</div>
                                <div class="text-secondary" style="font-size: 0.55rem;">PIN: C831</div>
                            </div>
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=50x50&data=C831" style="width: 32px; height: 32px;" alt="QR">
                        </div>

                        <!-- Scan Success message toast overlay -->
                        <div id="kiosk-barcode-success" style="display: none; position: absolute; bottom: 10px; left: 10px; right: 10px; z-index: 12;" class="p-2 rounded-sm bg-success text-white text-center fs-xs fw-700">
                            ✓ Badge Verified: John Doe Checked In!
                        </div>
                    </div>
                </div>
            </div>
            <p class="fs-xs text-center text-secondary m-0">
                Switch modes to see standard roster listings, secure keyboard locks, or fast camera badge scanners.
            </p>
        </div>
    </section>

    <!-- Summarized Overview Navigation Block -->
    <section class="d-flex flex-column gap-8 mt-12 mb-12 w-100">
        <div class="text-center">
            <h2 class="fs-3xl fw-800">Explore <span class="text-gradient">CenterTime</span></h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                Discover our comprehensive feature suite, transparent pricing plans, and platform answers.
            </p>
        </div>

        <div class="grid-cols-3 gap-6 w-100">
            <!-- Features Overview Card -->
            <div class="glass-panel p-8 d-flex flex-column justify-content-between text-left hover-lift w-100" style="border-top: 4px solid var(--primary); min-height: 320px;">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="icon-48 rounded-full bg-primary-glow text-primary d-flex align-items-center justify-content-center flex-shrink-0">
                            <span class="material-icons text-primary fs-2xl">auto_awesome</span>
                        </div>
                        <div>
                            <span class="fs-xs fw-700 text-uppercase text-indigo-200 tracking-wider">Capabilities</span>
                            <h3 class="fs-xl fw-700 m-0">Features</h3>
                        </div>
                    </div>
                    <p class="fs-md text-secondary lh-base mb-6">
                        Engineered for Precision &amp; Control. Explore time window enforcement, anti-brute force security lockouts, 10 core audit system events, and our streamlined CSV roster onboarding wizard.
                    </p>
                </div>
                <div>
                    <a href="{{ path('app_features') }}" class="btn btn-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                        Explore Features <span class="material-icons fs-sm">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- Pricing Overview Card -->
            <div class="glass-panel p-8 d-flex flex-column justify-content-between text-left hover-lift w-100" style="border-top: 4px solid #10b981; min-height: 320px;">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="icon-48 rounded-full bg-success-glow text-success d-flex align-items-center justify-content-center flex-shrink-0">
                            <span class="material-icons text-success fs-2xl">sell</span>
                        </div>
                        <div>
                            <span class="fs-xs fw-700 text-uppercase text-indigo-200 tracking-wider">Subscription Tiers</span>
                            <h3 class="fs-xl fw-700 m-0">Pricing &amp; Plans</h3>
                        </div>
                    </div>
                    <p class="fs-md text-secondary lh-base mb-6">
                        Simple, transparent pricing. View side-by-side plan comparisons, per-student monthly costs, category limits, and feature breakdowns for Basic, Silver, Gold, and Platinum tiers.
                    </p>
                </div>
                <div>
                    <a href="{{ path('app_pricing') }}" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                        View Pricing &amp; Plans <span class="material-icons fs-sm">arrow_forward</span>
                    </a>
                </div>
            </div>

            <!-- FAQ Overview Card -->
            <div class="glass-panel p-8 d-flex flex-column justify-content-between text-left hover-lift w-100" style="border-top: 4px solid #f59e0b; min-height: 320px;">
                <div>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="icon-48 rounded-full bg-warning-glow text-warning d-flex align-items-center justify-content-center flex-shrink-0">
                            <span class="material-icons text-warning fs-2xl">help_outline</span>
                        </div>
                        <div>
                            <span class="fs-xs fw-700 text-uppercase text-indigo-200 tracking-wider">Knowledge Base</span>
                            <h3 class="fs-xl fw-700 m-0">Frequently Asked Questions</h3>
                        </div>
                    </div>
                    <p class="fs-md text-secondary lh-base mb-6">
                        Got questions? Find clear answers regarding kiosk modes, roster importing, automatic session termination, anti-brute force protections, and subscription billing.
                    </p>
                </div>
                <div>
                    <a href="{{ path('app_faq') }}" class="btn btn-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                        Read FAQ <span class="material-icons fs-sm">help</span>
                    </a>
                </div>
            </div>
        </div>
    </section>    <script>
    // Mock Live Dashboard Ticker logic
    let mockSeconds1 = 15135; // 04:12:15
    let mockSeconds2 = 6303;  // 01:45:03
    let mockActiveCount = 12;

    function formatTime(totalSeconds) {
        const hrs = Math.floor(totalSeconds / 3600);
        const mins = Math.floor((totalSeconds % 3600) / 60);
        const secs = totalSeconds % 60;
        return [hrs, mins, secs].map(v => v < 10 ? "0" + v : v).join(":");
    }

    setInterval(() => {
        mockSeconds1++;
        mockSeconds2++;
        const timer1 = document.getElementById('mock-timer-1');
        const timer2 = document.getElementById('mock-timer-2');
        if (timer1) timer1.textContent = formatTime(mockSeconds1);
        if (timer2) timer2.textContent = formatTime(mockSeconds2);
        
        // Tick guest timers if added
        document.querySelectorAll('.mock-guest-timer').forEach(el => {
            let sec = parseInt(el.getAttribute('data-sec')) + 1;
            el.setAttribute('data-sec', sec);
            el.textContent = formatTime(sec);
        });
    }, 1000);

    // Mock Clock-In Event Simulation
    const btnClockIn = document.getElementById('btn-mock-clockin');
    const activityFeed = document.getElementById('mock-activity-feed');
    const activeCountDiv = document.getElementById('mock-active-count');

    if (btnClockIn) {
        btnClockIn.addEventListener('click', () => {
            mockActiveCount++;
            if (activeCountDiv) {
                activeCountDiv.textContent = mockActiveCount + " / 45";
            }
            
            const newRow = document.createElement('div');
            newRow.className = "d-flex justify-content-between align-items-center p-3 rounded-sm animate-fade-in";
            newRow.style.background = "rgba(255,255,255,0.02)";
            newRow.style.borderLeft = "3px solid var(--warning)";
            
            newRow.innerHTML = `
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar bg-warning text-white rounded-full d-flex align-items-center justify-content-center fw-600" style="width: 32px; height: 32px; font-size: 0.75rem;">G</div>
                    <div>
                        <div class="fs-sm fw-600">Guest User</div>
                        <div class="fs-xs text-secondary">Break Shift</div>
                    </div>
                </div>
                <span class="fs-xs text-muted mock-guest-timer" data-sec="0">00:00:00</span>
            `;
            activityFeed.appendChild(newRow);
            btnClockIn.disabled = true;
            btnClockIn.textContent = "Guest Active";
        });
    }

    // Lead Form submission simulation
    const btnSubmit = document.getElementById('btn-sales-submit');
    const leadEmail = document.getElementById('sales-lead-email');
    const successMsg = document.getElementById('sales-success-msg');

    if (btnSubmit) {
        btnSubmit.addEventListener('click', () => {
            if (leadEmail.value.trim() === '') {
                alert('Please enter a valid email address.');
                return;
            }
            successMsg.classList.remove('d-none');
            leadEmail.value = '';
        });
    }

    // Scroll Reveal Calculation Initialization
    function checkScroll() {
        const reveals = document.querySelectorAll('.reveal, .reveal-hero, .reveal-left, .reveal-right, .reveal-scale');
        const triggerPoint = window.innerHeight * 0.85; // trigger when element is 85% from top
        const exitPoint = window.innerHeight * 0.05;   // trigger exit when element is 5% from top
        const hasActiveState = ['reveal', 'reveal-hero', 'reveal-left', 'reveal-right', 'reveal-scale'];

        reveals.forEach(el => {
            const rect = el.getBoundingClientRect();
            // Check if element top is inside trigger zone and bottom is below exit zone
            if (rect.top < triggerPoint && rect.bottom > exitPoint) {
                el.classList.add('active');
            } else {
                el.classList.remove('active');
            }
        });
    }

    // Onboarding Steps Cycler
    const onboardingSteps = [
        { title: "Upload Roster CSV", icon: "upload_file", badge: "Step 1 of 5" },
        { title: "CSV Header Mapping", icon: "view_week", badge: "Step 2 of 5" },
        { title: "Fuzzy Matching Checks", icon: "rule", badge: "Step 3 of 5" },
        { title: "License Quota Check", icon: "verified", badge: "Step 4 of 5" },
        { title: "Onboarding Complete", icon: "done_all", badge: "Step 5 of 5" }
    ];

    let currentOnboardingStep = 1;
    let onboardingInterval = null;

    window.setOnboardingStep = function(stepNum, manual = false) {
        if (manual && onboardingInterval) {
            clearInterval(onboardingInterval);
            const indicator = document.getElementById('autoplay-indicator');
            if (indicator) {
                indicator.textContent = "PAUSED";
                indicator.style.color = "var(--warning)";
            }
        }
        currentOnboardingStep = stepNum;
        
        // Update slides
        document.querySelectorAll('.onboarding-slide').forEach(slide => {
            slide.classList.remove('active');
        });
        const activeSlide = document.getElementById(`onboarding-slide-${stepNum}`);
        if (activeSlide) {
            activeSlide.classList.add('active');
        }

        // Update dots
        const dots = document.querySelectorAll('#onboarding-dots .dot');
        dots.forEach((dot, idx) => {
            if (idx === (stepNum - 1)) {
                dot.classList.add('active');
            } else {
                dot.classList.remove('active');
            }
        });

        // Update titles / badges
        const info = onboardingSteps[stepNum - 1];
        document.getElementById('onboarding-step-icon').textContent = info.icon;
        document.getElementById('onboarding-step-title').textContent = info.title;
        document.getElementById('onboarding-step-badge').textContent = info.badge;
    };

    function startOnboardingCycle() {
        onboardingInterval = setInterval(() => {
            let nextStep = currentOnboardingStep + 1;
            if (nextStep > 5) {
                nextStep = 1;
            }
            window.setOnboardingStep(nextStep);
        }, 3500);
    }

    // Kiosk Mode Simulation Engine
    let kioskModeInterval = null;
    let currentKioskMode = 'basic';
    let kioskSimTimeout = null;

    window.setKioskMode = function(mode, manual = false) {
        if (manual && kioskModeInterval) {
            clearInterval(kioskModeInterval);
        }
        currentKioskMode = mode;

        // Clear ongoing timeouts
        if (kioskSimTimeout) clearTimeout(kioskSimTimeout);

        // Update tabs
        document.querySelectorAll('.kiosk-mode-tab').forEach(tab => {
            tab.classList.remove('active');
            if (tab.getAttribute('onclick').includes(`'${mode}'`)) {
                tab.classList.add('active');
            }
        });

        // Update frames
        document.querySelectorAll('.kiosk-frame').forEach(frame => {
            frame.style.display = 'none';
        });
        const activeFrame = document.getElementById(`kiosk-frame-${mode}`);
        if (activeFrame) activeFrame.style.display = 'block';

        runKioskSimulation(mode);
    };

    function runKioskSimulation(mode) {
        // Reset everything
        const cursor = document.getElementById('kiosk-mock-cursor');
        cursor.style.opacity = '0';
        cursor.style.top = '250px';
        cursor.style.left = '80%';

        const searchInput = document.getElementById('kiosk-basic-search');
        if (searchInput) searchInput.value = '';
        const searchContainer = document.getElementById('kiosk-basic-search-container');
        if (searchContainer) searchContainer.style.display = 'block';

        const row2 = document.getElementById('mock-row-2');
        if (row2) {
            row2.style.setProperty('display', 'none', 'important');
            row2.classList.remove('active-click');
        }
        const successBasic = document.getElementById('mock-basic-success');
        if (successBasic) successBasic.style.display = 'none';

        const checkinBtn = document.getElementById('mock-checkin-btn');
        if (checkinBtn) checkinBtn.classList.remove('active-click');

        // PIN resets
        document.getElementById('kiosk-pin-keypad-view').style.display = 'block';
        document.getElementById('kiosk-pin-success-view').style.display = 'none';
        document.querySelectorAll('.pin-dot').forEach(dot => dot.className = 'pin-dot');
        document.querySelectorAll('.mock-keypad-btn').forEach(btn => btn.classList.remove('active-key'));

        // Barcode resets
        const laser = document.getElementById('kiosk-laser-line');
        laser.className = 'laser-line';
        const mockBadge = document.getElementById('kiosk-mock-badge');
        mockBadge.className = 'mock-badge bg-card border p-3 rounded-md d-flex align-items-center gap-3';
        document.getElementById('kiosk-barcode-success').style.display = 'none';

        if (mode === 'basic') {
            // Simulation sequence for basic search + check-in
            kioskSimTimeout = setTimeout(() => {
                // Type "B"
                if (searchInput) searchInput.value = 'B';
                kioskSimTimeout = setTimeout(() => {
                    // Type "Bo"
                    if (searchInput) searchInput.value = 'Bo';
                    kioskSimTimeout = setTimeout(() => {
                        // Type "Bob"
                        if (searchInput) searchInput.value = 'Bob';
                        // Show row 2
                        if (row2) row2.style.setProperty('display', 'flex', 'important');

                        kioskSimTimeout = setTimeout(() => {
                            // Show cursor
                            cursor.style.opacity = '1';
                            cursor.style.top = '120px';
                            cursor.style.left = '80%';

                            kioskSimTimeout = setTimeout(() => {
                                // Move cursor to Check In button
                                cursor.style.top = '112px';
                                cursor.style.left = '75%';

                                kioskSimTimeout = setTimeout(() => {
                                    // Click Check In button
                                    if (checkinBtn) checkinBtn.classList.add('active-click');

                                    kioskSimTimeout = setTimeout(() => {
                                        // Check-in success state
                                        if (checkinBtn) checkinBtn.classList.remove('active-click');
                                        if (row2) row2.style.setProperty('display', 'none', 'important');
                                        if (searchContainer) searchContainer.style.display = 'none';
                                        if (successBasic) successBasic.style.display = 'block';
                                        cursor.style.opacity = '0';

                                        // Loop simulation after 4 seconds
                                        kioskSimTimeout = setTimeout(() => {
                                            runKioskSimulation('basic');
                                        }, 4000);
                                    }, 600);
                                }, 1200);
                            }, 1000);
                        }, 800);
                    }, 300);
                }, 300);
            }, 800);

        } else if (mode === 'pin') {
            // Simulation sequence for PIN input (C-8-3-1)
            const keys = ['C', '8', '3', '1'];
            
            function typeKey(idx) {
                if (idx >= keys.length) {
                    // Submit & Verify
                    kioskSimTimeout = setTimeout(() => {
                        document.getElementById('kiosk-pin-keypad-view').style.display = 'none';
                        document.getElementById('kiosk-pin-success-view').style.display = 'flex';
                        
                        kioskSimTimeout = setTimeout(() => {
                            runKioskSimulation('pin');
                        }, 4000);
                    }, 400);
                    return;
                }

                kioskSimTimeout = setTimeout(() => {
                    const keyChar = keys[idx];
                    const keyBtn = document.getElementById(`key-${keyChar}`);
                    if (keyBtn) keyBtn.classList.add('active-key');
                    
                    const dot = document.getElementById(`pin-dot-${idx+1}`);
                    if (dot) dot.classList.add('filled');

                    kioskSimTimeout = setTimeout(() => {
                        if (keyBtn) keyBtn.classList.remove('active-key');
                        typeKey(idx + 1);
                    }, 200);
                }, 400);
            }

            typeKey(0);

        } else if (mode === 'barcode') {
            // Simulation sequence for barcode badge scanning
            kioskSimTimeout = setTimeout(() => {
                // Slide badge up
                mockBadge.classList.add('scanning');

                kioskSimTimeout = setTimeout(() => {
                    // Flash laser scanner success green
                    laser.classList.add('scan-success');

                    kioskSimTimeout = setTimeout(() => {
                        // Show scan success toast
                        document.getElementById('kiosk-barcode-success').style.display = 'block';

                        kioskSimTimeout = setTimeout(() => {
                            runKioskSimulation('barcode');
                        }, 4000);
                    }, 500);
                }, 1500);
            }, 500);
        }
    }

    function startKioskAutoplay() {
        kioskModeInterval = setInterval(() => {
            let nextMode = 'basic';
            if (currentKioskMode === 'basic') nextMode = 'pin';
            else if (currentKioskMode === 'pin') nextMode = 'barcode';
            window.setKioskMode(nextMode);
        }, 8000);
    }



    document.addEventListener('DOMContentLoaded', () => {
        startOnboardingCycle();
        window.setKioskMode('basic');
        startKioskAutoplay();
    });
</script>
{% endblock %}


