    <!-- Pricing Section -->
    <section id="pricing-section" class="d-flex flex-column gap-12 reveal">
        <div class="text-center">
            <h2 class="fs-3xl">Simple, Transparent <span class="text-gradient">Subscription Tiers</span></h2>
            <p class="fs-lg text-secondary mt-2 ml-auto mr-auto max-w-700">
                Choose the best fit for your team. Start basic or unlock premium limits and audit exports.
            </p>
        </div>

        <div class="grid-cols-3 align-items-stretch gap-6">
            {% for plan in plans %}
                <div class="glass-panel text-primary d-flex flex-column justify-content-between position-relative" style="padding: 2.25rem; {% if plan.name == 'silver' %}border: 1px solid var(--primary); box-shadow: var(--shadow-glow);{% else %}border-color: var(--border-color);{% endif %}">
                    {% if plan.name == 'silver' %}
                        <div class="fs-sm fw-700 text-uppercase text-white rounded-full position-absolute" style="top: -15px; right: 2rem; background: var(--primary); padding: 0.35rem 1rem; box-shadow: var(--shadow-glow);">
                            Best Value
                        </div>
                    {% endif %}
                    <div>
                        <h3 class="fs-xl text-indigo-200 d-flex align-items-center gap-2" style="text-transform: capitalize">
                            <span class="material-icons text-primary">{% if plan.name == 'basic' %}tag{% elseif plan.name == 'silver' %}stars{% else %}military_tech{% endif %}</span> {{ plan.name }} Plan
                        </h3>
                        <div style="margin: 1.5rem 0;">
                            <span class="fw-800 fs-3xl">${{ plan.priceMonthly|round }}</span>
                            <span class="fs-md text-muted"> / month</span>
                        </div>
                        <ul class="fs-md text-secondary d-flex flex-column gap-3 mb-8 p-0" >
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                Up to {{ plan.maxOrgUsers|number_format }} Users
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                {% if plan.maxManagers >= 9999 %}Unlimited{% else %}{{ plan.maxManagers }}{% endif %} Manager{% if plan.maxManagers != 1 %}s{% endif %} limit
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                Up to {{ plan.maxCategories }} Categories & {{ plan.maxFields }} Custom Fields
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                {{ plan.sessionLimitHours }}-hour max sessions
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                {{ plan.retentionDays }} days history retention
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
