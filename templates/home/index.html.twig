                                <span class="material-icons fs-lg text-success">check_circle</span>
                                Up to {{ plan.maxOrgUsers|number_format }} Users
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                {% if plan.maxManagers >= 9999 %}Unlimited{% else %}{{ plan.maxManagers }}{% endif %} Manager{% if plan.maxManagers != 1 %}s{% endif %} limit
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                Up to {{ plan.maxCategories }} Categories & {{ plan.maxFields }} Custom Fields
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                {{ plan.sessionLimitHours }}-hour max sessions
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg text-success">check_circle</span>
                                {{ plan.retentionDays }} days history retention
                            </li>
                            <li class="{% if not plan.hasClickList %}text-muted {% endif %}d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg {% if plan.hasClickList %}text-success{% else %}text-muted{% endif %}">
                                    {% if plan.hasClickList %}check_circle{% else %}cancel{% endif %}
                                </span>
                                Click List - Check in
                            </li>
                            <li class="{% if not plan.hasSecureKiosk %}text-muted {% endif %}d-flex align-items-center gap-2">
                                <span class="material-icons fs-lg {% if plan.hasSecureKiosk %}text-success{% else %}text-muted{% endif %}">
                                    {% if plan.hasSecureKiosk %}check_circle{% else %}cancel{% endif %}
                                </span>
                                Secure pin - Check in
                            </li>
                            <li class="text-muted d-flex align-items-center gap-2" >
                                <span class="material-icons fs-lg text-muted {% if plan.hasCustomSessionDurations %}text-success{% endif %}" >
                                    {% if plan.hasCustomSessionDurations %}check_circle{% else %}cancel{% endif %}
                                </span>
                                Custom Session Limits
                            </li>
                            <li class="text-muted d-flex align-items-center gap-2" >
                                <span class="material-icons fs-lg text-muted {% if plan.hasOvertimeRules %}text-success{% endif %}" >
                                    {% if plan.hasOvertimeRules %}check_circle{% else %}cancel{% endif %}
                                </span>
                                Overtime Rules & Multipliers
                            </li>
                            <li class="text-muted d-flex align-items-center gap-2" >
                                <span class="material-icons fs-lg text-muted text-success" >
                                    {% if plan.exportsEnabled %}check_circle{% else %}cancel{% endif %}
                                </span>
                                Excel / CSV logs downloads
                            </li>
                            <li class="{% if not plan.hasBarcodeFeatures %}text-muted {% endif %}d-flex align-items-center gap-2" >
                                <span class="material-icons fs-lg {% if plan.hasBarcodeFeatures %}text-success{% else %}text-muted{% endif %}" >
                                    {% if plan.hasBarcodeFeatures %}check_circle{% else %}cancel{% endif %}
                                </span>
                                barcode scan - Check in
                            </li>
                        </ul>
                    </div>
                    {% if new_signups_enabled %}
                        <a href="{{ path('app_signup', {plan: plan.name}) }}" class="btn {% if plan.name == 'silver' %}btn-primary{% else %}btn-secondary{% endif %} w-100">
                            {% if plan.name == 'basic' %}Get Started Free{% else %}Start {{ plan.name|capitalize }} Trial{% endif %}
                        </a>
                    {% else %}
                        <button class="btn btn-secondary w-100" disabled style="opacity: 0.6; cursor: not-allowed;">Disabled</button>
                    {% endif %}
                </div>
            {% endfor %}
