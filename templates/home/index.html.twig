                    </div>
                </div>
                <a href="{{ path('app_demo') }}" class="btn btn-secondary w-100">Unlock Demo Access</a>
            </div>

            <!-- Demo 3: Console logins -->
            <div class="glass-panel d-flex flex-column justify-content-between h-100">
                <div>
                    <div class="text-primary d-inline-flex align-items-center justify-content-center mb-5 rounded-sm icon-44 bg-primary-glow">
                        <span class="material-icons">admin_panel_settings</span>
                    </div>
                    <h3 class="fs-xl mb-2">Manager Consoles</h3>
                    <p class="fs-md text-secondary mb-6">
                        Log in as an Organization Manager.
                    </p>
                    <div class="fs-sm text-secondary bg-input mb-6 p-4 rounded-sm text-center" >
                        <span class="material-icons text-muted mb-2">lock</span><br>
                        <strong>Credentials Locked</strong><br>
                        Unlock to view manager login details.
                    </div>
                </div>
                <a href="{{ path('app_demo') }}" class="btn btn-primary w-100">Unlock Demo Access</a>
