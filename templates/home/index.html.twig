                    {% if plan.name == 'silver' %}
                        <div class="fs-sm fw-700 text-uppercase text-white rounded-full position-absolute" style="top: -15px; right: 2rem; background: var(--primary); padding: 0.35rem 1rem; box-shadow: var(--shadow-glow);">
                            Best Value
                        </div>
                    {% endif %}
                    <div>
                        <h3 class="fs-xl text-indigo-200 d-flex align-items-center gap-2" style="text-transform: capitalize">
                            <span class="material-icons text-primary">{% if plan.name == 'basic' %}tag{% elseif plan.name == 'silver' %}stars{% elseif plan.name == 'gold' %}military_tech{% else %}workspace_premium{% endif %}</span> {{ plan.name }} Plan
                        </h3>
                        <div style="margin: 1.5rem 0;">
                            <span class="fw-800 fs-3xl">${{ plan.priceMonthly|round }}</span>
                            <span class="fs-md text-muted"> / month</span>
                        </div>
