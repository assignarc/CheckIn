{% extends 'home/layout.html.twig' %}

{% block title %}Subscription Pricing & Plan Comparison - CenterTime{% endblock %}



{% block content %}
<div class="container pricing-container" style="max-width: 1200px; margin: 2rem auto;">
    <!-- Pricing Section Header -->
    <div class="text-center mb-8">
        <span class="badge bg-primary-glow text-primary fs-xs fw-700 px-3 py-1.5 mb-3" style="border-radius: 99px; text-transform: uppercase; letter-spacing: 0.05em;">Transparent Plans &amp; Comparison</span>
        <h1 class="fs-3xl fw-800">Simple, Transparent <span class="text-gradient">Subscription Tiers</span></h1>
        <p class="fs-lg text-secondary mt-3 max-w-700 mx-auto">
            Choose the best fit for your team. Compare limits, check-in methods, and audit exports side-by-side.
        </p>
    </div>

    <!-- Detailed Plan Comparison Matrix -->
    <section class="d-flex flex-column gap-8 mb-16">
        <div class="glass-panel p-0 overflow-hidden" style="border-radius: var(--radius-md);">
            <div class="table-responsive comparison-table-wrapper">
                <table class="table comparison-table m-0">
                    <thead>
                        <tr>
                            <th class="sticky-col text-muted fs-xs text-uppercase tracking-wider">Features &amp; Specifications</th>
                            {% for plan in plans %}
                                <th class="text-center plan-col">
                                    <div class="fs-md fw-800 text-primary text-capitalize">{{ plan.name }}</div>
                                    <div class="fs-xl fw-800 mt-1">
                                        {% if plan.priceMonthly == 0 %}
                                            Free
                                        {% else %}
                                            ${{ plan.priceMonthly|number_format(2) }}<span class="fs-xs fw-400 text-secondary">/mo</span>
                                        {% endif %}
                                    </div>
                                    <div class="mt-3">
                                        {% if new_signups_enabled %}
                                            <a href="{{ path('app_signup', {plan: plan.name}) }}" class="btn {% if plan.name == 'silver' %}btn-primary{% else %}btn-secondary{% endif %} btn-sm w-100 py-1.5" style="font-size: 0.75rem;">
                                                {% if plan.name == 'basic' %}Get Started{% else %}Start Trial{% endif %}
                                            </a>
                                        {% else %}
                                            <button class="btn btn-secondary btn-sm w-100 py-1.5" disabled style="opacity: 0.6; cursor: not-allowed; font-size: 0.75rem;">Closed</button>
                                        {% endif %}
                                    </div>
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="sticky-col text-primary">
                                Maximum Registered Students
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">The total number of student accounts you can register in the system.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center text-secondary fs-md">
                                    {{ plan.maxOrgUsers|number_format }} students
                                </td>
                            {% endfor %}
                        </tr>

                        <tr>
                            <td class="sticky-col text-primary">
                                Cost / Student / Month
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">Calculated cost of subscription divided by user limit capacity.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center text-primary fw-700 fs-md">
                                    {% if plan.maxOrgUsers > 0 and plan.priceMonthly > 0 %}
                                        ${{ (plan.priceMonthly / plan.maxOrgUsers)|number_format(2) }}/mo
                                    {% else %}
                                        $0.00 (Free)
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>

                        <tr>
                            <td class="sticky-col text-primary">
                                Instructors/Managers
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">The number of manager profiles authorized to view reports and update settings.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center text-secondary fs-md">
                                    {% if plan.maxManagers >= 9999 %}
                                        <span class="badge bg-success-glow text-success px-2.5 py-1 rounded-sm">Unlimited</span>
                                    {% else %}
                                        {{ plan.maxManagers }} seats
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>

                        <tr>
                            <td class="sticky-col text-primary">
                                Max Shift Duration Limit
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">Longest duration a single session can remain open before the sweeper auto-terminates it.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center text-secondary fs-md">
                                    {{ plan.sessionLimitHours }} hours
                                </td>
                            {% endfor %}
                        </tr>

                        <tr>
                            <td class="sticky-col text-primary">
                                Data Retention Period
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">Number of days shift history and audit logs are retained in the database.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center text-secondary fs-md">
                                    {{ plan.retentionDays }} days
                                </td>
                            {% endfor %}
                        </tr>

                        <tr>
                            <td class="sticky-col text-primary">
                                Kiosk Check-In Mode
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">Attendance check-in mode. Open list select allows anyone to click a name; PIN is secure.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center text-secondary fs-md">
                                    {% if plan.name == 'basic' %}
                                        Open List Select
                                    {% else %}
                                        Secure PIN Pad Code
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>

                        <tr>
                            <td class="sticky-col text-primary">
                                QR Code Scan &amp; Badges
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">Scan credentials via QR badge generator tool and hands-free kiosk scanner.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center fs-md">
                                    {% if plan.name == 'gold' or plan.name == 'platinum' %}
                                        <span class="material-icons text-success">check_circle</span>
                                        <div class="fs-xs text-muted mt-1">Direct PDF printing</div>
                                    {% elseif plan.name == 'silver' %}
                                        <span class="material-icons text-warning">info</span>
                                        <div class="fs-xs text-muted mt-1">Manual generation only</div>
                                    {% else %}
                                        <span class="material-icons text-secondary" style="opacity: 0.4;">cancel</span>
                                        <div class="fs-xs text-muted mt-1">Not supported</div>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>

                        <tr>
                            <td class="sticky-col text-primary">
                                Data Export
                                <div class="tooltip-container">
                                    <span class="material-icons tooltip-icon">help_outline</span>
                                    <span class="tooltip-text">Export system timecard logs to Excel or CSV spreadsheets.</span>
                                </div>
                            </td>
                            {% for plan in plans %}
                                <td class="text-center fs-md">
                                    {% if plan.exportsEnabled %}
                                        <span class="material-icons text-success">check_circle</span>
                                        <div class="fs-xs text-muted mt-1">Enabled</div>
                                    {% else %}
                                        <span class="material-icons text-secondary" style="opacity: 0.4;">cancel</span>
                                        <div class="fs-xs text-muted mt-1">Disabled</div>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
{% endblock %}
